<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:viewModels="clr-namespace:ByteBuy.UI.ViewModels"
		mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
		Height="700" Width="1200"
		Icon="/Assets/logo.ico"
		CanResize="False"
		FontFamily="{DynamicResource SegoeUiThisBoldReqular}"
		x:Class="ByteBuy.UI.Views.LoginWindow"
		x:DataType="viewModels:LoginWindowViewModel"
		xmlns:dialogHost="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
		Title="ByteBuy MP v.1.0">

	<dialogHost:DialogHost Identifier="LoginDialogHost">
		<Grid ColumnDefinitions="*" Background="{DynamicResource SidebarGradientBrush}">

			<Grid ColumnDefinitions="50,*,50">

				<Ellipse Width="440" Height="440"
						 Fill="#1F6D4AE0"
						 HorizontalAlignment="Left"
						 VerticalAlignment="Bottom"
						 Margin="-190,0,0,-170"
						 IsHitTestVisible="False"/>

				<StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Vertical">

					<Border Classes="sectionBorder"
							BorderThickness="1"
							Background="{DynamicResource CardBackground}"
							CornerRadius="5"
							Padding="40"
							Width="400" Height="450" Margin="0,30">
						<Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="20">

							<!-- Header -->
							<StackPanel Grid.Row="0" Spacing="5">
								<TextBlock Grid.Row="0"
										   FontSize="30"
										   FontFamily="{DynamicResource RalewayBold}"
										   Foreground="White"
										   HorizontalAlignment="Center"
										   VerticalAlignment="Center"><Run Text="Byte"/><Run Text="&amp;" Foreground="{DynamicResource PrimaryAccentBrush}"/><Run Text="Buy"/></TextBlock>
								<TextBlock
									Text="Enter your credentials to access your account." FontSize="15"
									Foreground="{DynamicResource TextPrimary}"
									FontFamily="RalewayBold"
									TextWrapping="Wrap"
									FontWeight="600" />
							</StackPanel>

							<!-- Input Fields -->
							<StackPanel Grid.Row="1" Margin="0,10,0,0" Spacing="7">

								<TextBlock Text="Email"

										   FontWeight="600"
										   FontSize="15"
										   FontFamily="OpenSansBold"
										   Foreground="{DynamicResource TextPrimary}" />

								<TextBox Watermark="Enter your email"
										 Text="{Binding Email}"
										 Height="35" />

								<TextBlock Text="Password"
										   FontWeight="600"
										   FontSize="15"
										   FontFamily="OpenSansBold"
										   Foreground="{DynamicResource TextPrimary}" />

								<TextBox Watermark="Enter your password"
										 PasswordChar="*"
										 Text="{Binding Password}"
										 Height="35" />


								<StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
									<CheckBox IsChecked="{Binding RememeberMe}"/>
									<TextBlock Text="Remember Me" FontWeight="600" Margin="0,6"
											   FontSize="15" FontFamily="OpenSansBold"/>
								</StackPanel>

								<Border Background="#25FF4444"
										BorderBrush="#60FF4444"
										BorderThickness="1"
										CornerRadius="8"
										Padding="10,8"
										IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
									<TextBlock Text="{Binding Error}"
											   FontSize="13"
											   FontWeight="600"
											   TextWrapping="Wrap"
											   Foreground="{DynamicResource ErrorBrush}" />
								</Border>

							</StackPanel>

							<!-- Action Button -->
							<StackPanel Grid.Row="2">
								<Button Content="Log In"
										IsDefault="True"
										Command="{Binding LoginCommand}"
										HorizontalAlignment="Stretch"
										Height="40" />
							</StackPanel>
						</Grid>
					</Border>
				</StackPanel>

				<Button
					Command="{Binding OpenSettingsDialogCommand}"
					Grid.Column="2"
					VerticalAlignment="Bottom"
					HorizontalAlignment="Center"
					Height="40"
					Width="40"
					Margin="5">
					<Image Source="{SvgImage /Assets/Images/regular/gear-solid-full.svg}"/>
				</Button>

				<Button
					Command="{Binding ShutdownCommand}"
					Grid.Column="0"
					VerticalAlignment="Bottom"
					HorizontalAlignment="Center"
					Height="40"
					Width="40"
					Margin="5">
					<Image Source="{SvgImage /Assets/Images/regular/power-off-solid-full.svg}"/>
				</Button>
			</Grid>
		</Grid>
	</dialogHost:DialogHost>
</Window>