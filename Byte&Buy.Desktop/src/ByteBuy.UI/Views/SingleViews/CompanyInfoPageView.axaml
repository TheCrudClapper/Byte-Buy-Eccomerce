<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="clr-namespace:ByteBuy.UI.ViewModels"
			 xmlns:shared="clr-namespace:ByteBuy.UI.Views.Shared"
			 Background="Transparent"
			 mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
			 x:DataType="vm:CompanyInfoPageViewModel"
			 x:Class="ByteBuy.UI.Views.CompanyInfoPageView">

	<Grid>
		<Grid RowDefinitions="auto,*" ColumnDefinitions="380,24,*" Margin="0,10,30,30">

			<!-- Page Title -->
			<TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
					   Classes="pageTitle" Text="Company Details" Margin="0,0,0,20"/>

			<!-- LEFT: company summary -->
			<Border Grid.Row="1" Grid.Column="0"
					Classes="sectionBorder" Padding="24"
					VerticalAlignment="Top">
				<Grid ColumnDefinitions="auto,*" ColumnSpacing="20">
					<Border Background="{DynamicResource ButtonGradient}"
							CornerRadius="16"
							BorderBrush="{DynamicResource PrimaryAccentBrush}"
							BorderThickness="1"
							Width="104" Height="104">
						<Image Source="{SvgImage /Assets/Images/regular/computer-solid-full.svg}"
							   Height="64" Width="64" />
					</Border>

					<StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
						<TextBlock Classes="sectionLabel"
								   Text="{Binding CompanyName}"
								   TextWrapping="Wrap"/>
						<TextBlock Classes="textBoxLabel"
								   Foreground="{DynamicResource TextMutedBrush}"
								   TextTrimming="CharacterEllipsis"
								   Text="{Binding Tin, StringFormat='TIN: {0}'}"/>
					</StackPanel>
				</Grid>
			</Border>

			<!-- RIGHT SIDE: form cards -->
			<Grid Grid.Row="1" Grid.Column="2" RowDefinitions="*,auto" RowSpacing="20">
				<ScrollViewer Grid.Row="0" Padding="0,0,12,0" ScrollViewer.AllowAutoHide="False">
					<StackPanel Spacing="20">

						<!-- General Information -->
						<Border Classes="sectionBorder" Padding="28,24">
							<StackPanel Spacing="14">
								<StackPanel Orientation="Horizontal" Spacing="8">
									<Image Classes="sectionMarker" VerticalAlignment="Center"
										   Source="{SvgImage /Assets/Images/regular/square-solid-full-primary.svg}"/>
									<TextBlock Text="General Information" Classes="sectionLabel" VerticalAlignment="Center"/>
								</StackPanel>

								<Grid ColumnDefinitions="*,*" ColumnSpacing="20"
									  RowDefinitions="auto,auto" RowSpacing="14">
									<StackPanel Grid.Row="0" Grid.Column="0" Spacing="6">
										<TextBlock Text="Company Name" Classes="textBoxLabel"/>
										<TextBox Text="{Binding CompanyName}"/>
									</StackPanel>
									<StackPanel Grid.Row="0" Grid.Column="1" Spacing="6">
										<TextBlock Text="TIN (Taxpayer Identification Number)" Classes="textBoxLabel"/>
										<TextBox Text="{Binding Tin}"/>
									</StackPanel>
									<StackPanel Grid.Row="1" Grid.Column="0" Spacing="6">
										<TextBlock Text="Email" Classes="textBoxLabel"/>
										<TextBox Text="{Binding Email}"/>
									</StackPanel>
									<StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
										<TextBlock Text="Phone Number" Classes="textBoxLabel"/>
										<TextBox Text="{Binding PhoneNumber}"/>
									</StackPanel>
								</Grid>
							</StackPanel>
						</Border>

						<!-- Address -->
						<Border Classes="sectionBorder" Padding="28,24">
							<StackPanel Spacing="14">
								<StackPanel Orientation="Horizontal" Spacing="8">
									<Image Classes="sectionMarker" VerticalAlignment="Center"
										   Source="{SvgImage /Assets/Images/regular/square-solid-full-primary.svg}"/>
									<TextBlock Text="Address" Classes="sectionLabel" VerticalAlignment="Center"/>
								</StackPanel>

								<Grid ColumnDefinitions="*,*" ColumnSpacing="20"
									  RowDefinitions="auto,auto,auto,auto" RowSpacing="14">
									<StackPanel Grid.Row="0" Grid.Column="0" Spacing="6">
										<TextBlock Text="Street" Classes="textBoxLabel"/>
										<TextBox Text="{Binding Street}"/>
									</StackPanel>
									<StackPanel Grid.Row="0" Grid.Column="1" Spacing="6">
										<TextBlock Text="City" Classes="textBoxLabel"/>
										<TextBox Text="{Binding City}"/>
									</StackPanel>

									<StackPanel Grid.Row="1" Grid.Column="0" Spacing="6">
										<TextBlock Text="House Number" Classes="textBoxLabel"/>
										<TextBox Text="{Binding HouseNumber}"/>
									</StackPanel>
									<StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
										<TextBlock Text="Flat Number" Classes="textBoxLabel"/>
										<TextBox Text="{Binding FlatNumber}"/>
									</StackPanel>

									<StackPanel Grid.Row="2" Grid.Column="0" Spacing="6">
										<TextBlock Text="Postal Code" Classes="textBoxLabel"/>
										<TextBox Text="{Binding PostalCode}"/>
									</StackPanel>
									<StackPanel Grid.Row="2" Grid.Column="1" Spacing="6">
										<TextBlock Text="Postal City" Classes="textBoxLabel"/>
										<TextBox Text="{Binding PostalCity}"/>
									</StackPanel>

									<StackPanel Grid.Row="3" Grid.Column="0" Spacing="6">
										<TextBlock Text="Country" Classes="textBoxLabel"/>
										<TextBox Text="{Binding Country}"/>
									</StackPanel>
								</Grid>
							</StackPanel>
						</Border>

						<!-- Marketing -->
						<Border Classes="sectionBorder" Padding="28,24">
							<StackPanel Spacing="14">
								<StackPanel Orientation="Horizontal" Spacing="8">
									<Image Classes="sectionMarker" VerticalAlignment="Center"
										   Source="{SvgImage /Assets/Images/regular/square-solid-full-primary.svg}"/>
									<TextBlock Text="Marketing" Classes="sectionLabel" VerticalAlignment="Center"/>
								</StackPanel>

								<StackPanel Spacing="6">
									<TextBlock Text="Slogan" Classes="textBoxLabel"/>
									<TextBox Text="{Binding Slogan}"/>
								</StackPanel>
							</StackPanel>
						</Border>

					</StackPanel>
				</ScrollViewer>

				<!-- Actions -->
				<Border Grid.Row="1" Classes="sectionBorder" Padding="20">
					<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
						<Button Content="Clear" MinWidth="100"
								HorizontalContentAlignment="Center"
								Command="{Binding ClearCommand}"/>
						<Button Content="Save" MinWidth="100"
								HorizontalContentAlignment="Center"
								Command="{Binding SaveCommand}"/>
					</StackPanel>
				</Border>
			</Grid>
		</Grid>
	</Grid>
</UserControl>