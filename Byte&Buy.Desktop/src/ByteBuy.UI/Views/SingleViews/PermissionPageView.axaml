<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:views="using:ByteBuy.UI.Views.Shared"
			 xmlns:vm="clr-namespace:ByteBuy.UI.ViewModels.SingleViewModels"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:DataType="vm:PermissionPageViewModel"
			 x:Class="ByteBuy.UI.Views.SingleViews.PermissionPageView">

	<Grid RowDefinitions="auto, auto" RowSpacing="20" Margin="0,10,30,30">

		<!--Page Title-->
		<TextBlock Grid.Row="0" Classes="pageTitle" Text="Permission"/>

		<!-- Form-->
		<Border Grid.Row="2"
				Padding="20"
				VerticalAlignment="Top"
				Classes="sectionBorder">

			<StackPanel Spacing="14">
				<StackPanel Grid.Row="0"
							Grid.ColumnSpan="2"
							Spacing="8"
							Orientation="Horizontal">
					<Image
						Source="{SvgImage /Assets/Images/regular/square-solid-full-primary.svg}"
						Classes="sectionMarker" />
					<TextBlock Text="General Information" Classes="sectionLabel" VerticalAlignment="Center"/>
				</StackPanel>

				<Grid ColumnDefinitions="*, *" HorizontalAlignment="Stretch" ColumnSpacing="12">
					<StackPanel Spacing="6" Grid.Column="0">
						<TextBlock Text="Name" Classes="textBoxLabel"/>
						<TextBox Text="{Binding Name}" />
					</StackPanel>

					<Grid ColumnDefinitions="*,*" RowDefinitions="auto,auto" RowSpacing="6" Grid.Column="1">
						<TextBlock Grid.Row="0" Grid.Column="0" Text="Description" Classes="textBoxLabel"/>
						<views:CharCounter Grid.Row="0" Grid.Column="1" DataContext="{Binding CharCounter}"/>
						<TextBox Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Description}" TextWrapping="Wrap" MinHeight="100" />
					</Grid>
				</Grid>

				<Border Padding="0,20,0,0"
						Grid.Row="2"
						Grid.ColumnSpan="3"
						BorderThickness="0,1,0,0"
						BorderBrush="{DynamicResource GrayAccentBrush}">
					<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
						<Button Content="Clear" MinWidth="100"
								HorizontalContentAlignment="Center"
								Command="{Binding ClearCommand}"/>
						<Button Content="Save" MinWidth="100"
								HorizontalContentAlignment="Center"
								Command="{Binding SaveCommand}"/>
					</StackPanel>
				</Border>

			</StackPanel>
		</Border>
	</Grid>
</UserControl>
