<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="clr-namespace:ByteBuy.UI.ViewModels"
			 xmlns:views="clr-namespace:ByteBuy.UI.Views.Shared"
			 mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="900"
			 x:Class="ByteBuy.UI.Views.ProfilePageView"
			 Background="Transparent"
			 x:DataType="vm:ProfilePageViewModel">

	<Grid RowDefinitions="auto,*" ColumnDefinitions="380,24,*" Margin="0,10,30,30">

		<!-- Page Title -->
		<TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
				   Classes="pageTitle" Text="Profile" Margin="0,0,0,20"/>

		<!-- LEFT: avatar + name -->
		<Border Grid.Row="1" Grid.Column="0"
				Classes="sectionBorder" Padding="24"
				VerticalAlignment="Top">
			<StackPanel Spacing="16" HorizontalAlignment="Center">
				<Border Background="{DynamicResource ButtonGradient}"
						CornerRadius="16"
						BorderBrush="{DynamicResource PrimaryAccentBrush}"
						BorderThickness="1"
						HorizontalAlignment="Center">
					<Image Source="{SvgImage /Assets/Images/regular/user-solid-full.svg}"
						   Height="110" Width="110" Margin="20"/>
				</Border>

				<StackPanel Spacing="4" HorizontalAlignment="Center">
					<StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
						<TextBlock Classes="sectionLabel" Text="{Binding FirstName}"/>
						<TextBlock Classes="sectionLabel" Text="{Binding LastName}"/>
					</StackPanel>
					<TextBlock Classes="sectionHelperText"
							   HorizontalAlignment="Center"
							   Text="{Binding RoleName}"/>
				</StackPanel>
			</StackPanel>
		</Border>

		<!-- RIGHT: form cards -->
		<Grid Grid.Row="1" Grid.Column="2" RowDefinitions="*,auto" RowSpacing="20">
			<ScrollViewer Grid.Row="0" Padding="0,0,12,0" ScrollViewer.AllowAutoHide="False">
				<StackPanel Spacing="20">

					<!-- Personal Information -->
					<Border Classes="sectionBorder" Padding="28,24">
						<StackPanel Spacing="14">
							<StackPanel Orientation="Horizontal" Spacing="8">
								<Image Classes="sectionMarker" VerticalAlignment="Center"
									   Source="{SvgImage /Assets/Images/regular/square-solid-full-primary.svg}"/>
								<TextBlock Text="Personal Information" Classes="sectionLabel" VerticalAlignment="Center"/>
							</StackPanel>

							<Grid ColumnDefinitions="*,*" ColumnSpacing="20"
								  RowDefinitions="auto,auto,auto" RowSpacing="14">
								<StackPanel Grid.Row="0" Grid.Column="0" Spacing="6">
									<TextBlock Text="First Name" Classes="textBoxLabel"/>
									<TextBox IsEnabled="False" Text="{Binding FirstName}"/>
								</StackPanel>
								<StackPanel Grid.Row="0" Grid.Column="1" Spacing="6">
									<TextBlock Text="Last Name" Classes="textBoxLabel"/>
									<TextBox IsEnabled="False" Text="{Binding LastName}"/>
								</StackPanel>

								<StackPanel Grid.Row="1" Grid.Column="0" Spacing="6">
									<TextBlock Text="Email" Classes="textBoxLabel"/>
									<TextBox IsEnabled="False" Text="{Binding Email}"/>
								</StackPanel>
								<StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
									<TextBlock Text="Role" Classes="textBoxLabel"/>
									<TextBox IsEnabled="False" Text="{Binding RoleName}"/>
								</StackPanel>

								<StackPanel Grid.Row="2" Grid.Column="0" Spacing="6">
									<TextBlock Text="Phone Number" Classes="textBoxLabel"/>
									<TextBox Text="{Binding PhoneNumber}"/>
								</StackPanel>
							</Grid>
						</StackPanel>
					</Border>

					<!-- Address Info -->
					<Border Classes="sectionBorder" Padding="28,24">
						<StackPanel Spacing="14">
							<StackPanel Orientation="Horizontal" Spacing="8">
								<Image Classes="sectionMarker" VerticalAlignment="Center"
									   Source="{SvgImage /Assets/Images/regular/square-solid-full-primary.svg}"/>
								<TextBlock Text="Address Info" Classes="sectionLabel" VerticalAlignment="Center"/>
							</StackPanel>

							<Grid ColumnDefinitions="*,*" ColumnSpacing="20"
								  RowDefinitions="auto,auto,auto,auto" RowSpacing="14">
								<StackPanel Grid.Row="0" Grid.Column="0" Spacing="6">
									<TextBlock Text="Street" Classes="textBoxLabel"/>
									<TextBox Text="{Binding Street}"/>
								</StackPanel>
								<StackPanel Grid.Row="0" Grid.Column="1" Spacing="6">
									<TextBlock Text="City" Classes="textBoxLabel"/>
									<TextBox Text="{Binding City}"/>
								</StackPanel>

								<StackPanel Grid.Row="1" Grid.Column="0" Spacing="6">
									<TextBlock Text="House Number" Classes="textBoxLabel"/>
									<TextBox Text="{Binding HouseNumber}"/>
								</StackPanel>
								<StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
									<TextBlock Text="Flat Number" Classes="textBoxLabel"/>
									<TextBox Text="{Binding FlatNumber}"/>
								</StackPanel>

								<StackPanel Grid.Row="2" Grid.Column="0" Spacing="6">
									<TextBlock Text="Postal Code" Classes="textBoxLabel"/>
									<TextBox Text="{Binding PostalCode}"/>
								</StackPanel>
								<StackPanel Grid.Row="2" Grid.Column="1" Spacing="6">
									<TextBlock Text="Postal City" Classes="textBoxLabel"/>
									<TextBox Text="{Binding PostalCity}"/>
								</StackPanel>

								<StackPanel Grid.Row="3" Grid.Column="0" Spacing="6">
									<TextBlock Text="Country" Classes="textBoxLabel"/>
									<TextBox Text="{Binding Country}"/>
								</StackPanel>
							</Grid>
						</StackPanel>
					</Border>

					<!-- Password change -->
					<Border Classes="sectionBorder" Padding="28,24">
						<views:PasswordChangeView DataContext="{Binding PasswordComponent}"/>
					</Border>

				</StackPanel>
			</ScrollViewer>

			<!-- Actions -->
			<Border Grid.Row="1" Classes="sectionBorder" Padding="20">
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
					<Button Content="Clear" MinWidth="100"
							HorizontalContentAlignment="Center"
							Command="{Binding ClearCommand}"/>
					<Button Content="Save Changes" Classes="accent" MinWidth="130"
							HorizontalContentAlignment="Center"
							Command="{Binding SaveCommand}"/>
				</StackPanel>
			</Border>
		</Grid>
	</Grid>
</UserControl>