<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:views="clr-namespace:ByteBuy.UI.Views.Shared"
			 xmlns:vm="clr-namespace:ByteBuy.UI.ViewModels"
			 mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="900"
			 x:Class="ByteBuy.UI.Views.RolePageView"
			 x:DataType="vm:RolePageViewModel">

	<Grid RowDefinitions="auto,auto,*" RowSpacing="20" Margin="0,10,30,30">

		<!-- Page Title -->
		<TextBlock Grid.Row="0" Classes="pageTitle" Text="Role"/>

		<!-- Role System Guide (collapsible) -->
		<Border Grid.Row="1" Classes="sectionBorder" Padding="28,24">
			<StackPanel Spacing="16">

				<Grid ColumnDefinitions="*,auto">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<Image Classes="sectionMarker" VerticalAlignment="Center"
							   Source="{SvgImage /Assets/Images/regular/square-solid-full-primary.svg}"/>
						<TextBlock Text="Role System Guide" Classes="sectionLabel" VerticalAlignment="Center"/>
					</StackPanel>

					<Button Grid.Column="1" Command="{Binding ToggleTutorialCommand}">
						<Image Source="{SvgImage /Assets/Images/regular/up-down-solid-full.svg}"
							   Width="15" Height="15"/>
					</Button>
				</Grid>

				<!-- Collapsible content -->
				<StackPanel Spacing="14" IsVisible="{Binding IsTutorialExpanded}">

					<StackPanel Spacing="6">
						<TextBlock Classes="standardText" TextWrapping="Wrap"
								   Text="To use the system efficiently and securely, you need to understand roles and permissions."/>
						<TextBlock Classes="standardText" TextWrapping="Wrap"
								   Text="Each role is composed of a unique set of permissions. Permissions define which resources a role has access to and what actions can be taken on them."/>
					</StackPanel>

					<!-- Permission format -->
					<Border Background="{DynamicResource GrayAccentBrush}"
							CornerRadius="10"
							Padding="16,12">
						<StackPanel Spacing="4" HorizontalAlignment="Center">
							<TextBlock Classes="fieldLabel" HorizontalAlignment="Center"
									   Text="Permission format"/>
							<TextBlock Classes="headerText" HorizontalAlignment="Center"
									   Text="[resource]:[action]:[scope?]"/>
						</StackPanel>
					</Border>

					<!-- Parts -->
					<Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
						<StackPanel Grid.Column="0" Spacing="4">
							<TextBlock Classes="standardText bold" Text="[resource]"/>
							<TextBlock Classes="sectionHelperText" TextWrapping="Wrap"
									   Text="The global resource, such as roles, users, orders, etc."/>
						</StackPanel>

						<StackPanel Grid.Column="1" Spacing="4">
							<TextBlock Classes="standardText bold" Text="[action]"/>
							<TextBlock Classes="sectionHelperText" TextWrapping="Wrap"
									   Text="What the permission owner can do with the resource: read, write, update, delete."/>
						</StackPanel>

						<StackPanel Grid.Column="2" Spacing="4">
							<TextBlock Classes="standardText bold" Text="[scope]"/>
							<TextBlock Classes="sectionHelperText" TextWrapping="Wrap">
								<Run Text="Refines the action."/>
								<LineBreak/>
								<Run Text="many" FontStyle="Italic"/>
								<Run Text="– refers to collections."/>
								<LineBreak/>
								<Run Text="self" FontStyle="Italic"/>
								<Run Text="– e.g. users can read info only about themselves."/>
							</TextBlock>
						</StackPanel>
					</Grid>
				</StackPanel>
			</StackPanel>
		</Border>

		<!-- Body -->
		<Grid Grid.Row="2" ColumnDefinitions="380,24,*">

			<!-- LEFT: role form -->
			<Border Grid.Column="0" Classes="sectionBorder" Padding="24" VerticalAlignment="Top">
				<StackPanel Spacing="14">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<Image Classes="sectionMarker" VerticalAlignment="Center"
							   Source="{SvgImage /Assets/Images/regular/square-solid-full-primary.svg}"/>
						<TextBlock Text="General Information" Classes="sectionLabel" VerticalAlignment="Center"/>
					</StackPanel>

					<StackPanel Spacing="6">
						<TextBlock Text="Role" Classes="textBoxLabel"/>
						<TextBox Text="{Binding RoleName}"/>
					</StackPanel>

					<Border Padding="0,20,0,0"
							BorderThickness="0,1,0,0"
							BorderBrush="{DynamicResource GrayAccentBrush}">
						<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
							<Button Content="Clear" MinWidth="100"
									HorizontalContentAlignment="Center"
									Command="{Binding ClearCommand}"/>
							<Button Content="Save" Classes="accent" MinWidth="100"
									HorizontalContentAlignment="Center"
									Command="{Binding SaveCommand}"/>
						</StackPanel>
					</Border>
				</StackPanel>
			</Border>

			<!-- RIGHT: permissions -->
			<Border Grid.Column="2" Classes="sectionBorder" Padding="28,24">
				<Grid RowDefinitions="auto,16,*">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<Image Classes="sectionMarker" VerticalAlignment="Center"
							   Source="{SvgImage /Assets/Images/regular/square-solid-full-primary.svg}"/>
						<TextBlock Text="Permissions" Classes="sectionLabel" VerticalAlignment="Center"/>
					</StackPanel>

					<ScrollViewer Grid.Row="2" ScrollViewer.AllowAutoHide="False">
						<views:PermissionListBoxView DataContext="{Binding PermissionListBox}"/>
					</ScrollViewer>
				</Grid>
			</Border>
		</Grid>
	</Grid>
</UserControl>