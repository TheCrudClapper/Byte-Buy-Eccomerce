<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="clr-namespace:ByteBuy.UI.ViewModels"
			 xmlns:dashboard="clr-namespace:ByteBuy.UI.ViewModels.Dashboard"
			 xmlns:charts="clr-namespace:ByteBuy.UI.ViewModels.Charts"
			 xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
			 mc:Ignorable="d" d:DesignWidth="1350" d:DesignHeight="900"
			 x:DataType="vm:DashboardPageViewModel"
			 Background="{DynamicResource Background}"
			 x:Class="ByteBuy.UI.Views.DashboardPageView">

	<UserControl.Styles>
		<StyleInclude Source="../../Styles/DashboardStyles.axaml" />
	</UserControl.Styles>

	<ScrollViewer>
		<Grid RowDefinitions="auto,24,auto,20,340,20,340" Margin="0,10,30,30">

			<!-- Header -->
			<Grid Grid.Row="0" ColumnDefinitions="auto,*" ColumnSpacing="16">
				<Border Width="56" Height="56" CornerRadius="28"
						Background="{DynamicResource ButtonGradient}"
						BorderBrush="{DynamicResource PrimaryAccentBrush}"
						BorderThickness="1">
					<Image Source="{SvgImage /Assets/Images/regular/circle-user-solid-full.svg}"
						   Height="34" Width="34"/>
				</Border>
				<StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
					<TextBlock Classes="dbHeading">
						<Run Text="Welcome"/>
						<Run Text="{Binding UserFirstName}"/>
						<Run Text="{Binding UserLastName}"/>
						<Run Text="!"/>
					</TextBlock>
					<TextBlock Classes="dbSub" Text="Here is a portion of stats just for you."/>
				</StackPanel>
			</Grid>

			<!-- KPI cards -->
			<ItemsControl Grid.Row="2" ItemsSource="{Binding Kpis}">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<UniformGrid Rows="1" ColumnSpacing="16"/>
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>

				<ItemsControl.ItemTemplate>
					<DataTemplate x:DataType="dashboard:KpiViewModel">
						<Border Classes="dbCard" Padding="20" Height="112">
							<Grid ColumnDefinitions="*,auto" ColumnSpacing="12">
								<StackPanel VerticalAlignment="Center" Spacing="4">
									<TextBlock Classes="dbKpiLabel" Text="{Binding Label}" TextWrapping="Wrap"/>
									<TextBlock Classes="dbKpiValue" Text="{Binding DisplayValue}"/>
								</StackPanel>
								<Border Grid.Column="1" Classes="dbIconTile">
									<Image>
										<Image.Source>
											<SvgImage Source="{Binding IconPath}"/>
										</Image.Source>
									</Image>
								</Border>
							</Grid>
						</Border>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>

			<!-- Charts row -->
			<Grid Grid.Row="4" ColumnDefinitions="60*,40*" ColumnSpacing="16">
				<Border Grid.Column="0" Classes="dbCard">
					<lvc:CartesianChart Background="{DynamicResource CardBackground}">
						<lvc:CartesianChart.Title>
							<lvc:XamlDrawnLabelVisual
								Text="Gross Market Value (last 6 months)"
								Paint="{lvc:SolidColorPaint Color='#ffffff'}"
								TextSize="16"/>
						</lvc:CartesianChart.Title>
						<lvc:CartesianChart.Series>
							<lvc:XamlLineSeries
								Values="{Binding GmvValues}"
								Fill="{x:Null}"
								LineSmoothness="0.6"
								GeometrySize="12"/>
						</lvc:CartesianChart.Series>
					</lvc:CartesianChart>
				</Border>

				<Border Grid.Column="1" Classes="dbCard">
					<lvc:PieChart SeriesSource="{Binding GmvBySellerData}"
								  InitialRotation="-90"
								  Background="{DynamicResource CardBackground}">
						<lvc:PieChart.Title>
							<lvc:XamlDrawnLabelVisual
								Text="GMV by Seller Type (PLN)"
								Paint="{lvc:SolidColorPaint Color='#ffffff'}"
								TextSize="16"/>
						</lvc:PieChart.Title>
						<lvc:PieChart.SeriesTemplate>
							<DataTemplate x:DataType="charts:PieChartViewModel">
								<lvc:XamlPieSeries
									SeriesName="{Binding Name}"
									Values="{Binding Values}"
									InnerRadius="50"
									MaxRadialColumnWidth="40"/>
							</DataTemplate>
						</lvc:PieChart.SeriesTemplate>
					</lvc:PieChart>
				</Border>
			</Grid>

			<!-- Orders + chart row -->
			<Grid Grid.Row="6" ColumnDefinitions="60*,40*" ColumnSpacing="16">

				<Border Grid.Column="0" Classes="dbCard" Padding="20">
					<Grid RowDefinitions="auto,auto,*">
						<TextBlock Grid.Row="0" Classes="dbCardTitle" Text="Recent Orders"/>

						<!-- Header -->
						<Grid Grid.Row="1" ColumnDefinitions="35*,22*,23*,20*" Margin="10,16,10,6">
							<TextBlock Grid.Column="0" Classes="dbTh" Text="BUYER"/>
							<TextBlock Grid.Column="1" Classes="dbTh" Text="PURCHASED" HorizontalAlignment="Center"/>
							<TextBlock Grid.Column="2" Classes="dbTh" Text="PRICE" HorizontalAlignment="Center"/>
							<TextBlock Grid.Column="3" Classes="dbTh" Text="STATUS" HorizontalAlignment="Center"/>
						</Grid>

						<ScrollViewer Grid.Row="2" ScrollViewer.AllowAutoHide="False">
							<ItemsControl ItemsSource="{Binding Orders}">
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="dashboard:OrderDashboardViewModel">
										<Border Classes="dbRow">
											<Grid ColumnDefinitions="35*,22*,23*,20*">
												<TextBlock Grid.Column="0" Classes="dbTd"
														   Text="{Binding BuyerEmail}"
														   TextTrimming="CharacterEllipsis"/>
												<TextBlock Grid.Column="1" Classes="dbTd"
														   Text="{Binding PurchaseDate}"
														   HorizontalAlignment="Center"/>
												<TextBlock Grid.Column="2" Classes="dbTd"
														   Text="{Binding Price.Display}"
														   HorizontalAlignment="Center"/>
												<Border Grid.Column="3" Classes="dbPill">
													<TextBlock Text="{Binding Status}"/>
												</Border>
											</Grid>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</ScrollViewer>
					</Grid>
				</Border>

				<Border Grid.Column="1" Classes="dbCard">
					<lvc:CartesianChart Background="{DynamicResource CardBackground}">
						<lvc:CartesianChart.Title>
							<lvc:XamlDrawnLabelVisual
								Text="Orders over time (last 6 months)"
								Paint="{lvc:SolidColorPaint Color='#ffffff'}"
								TextSize="16"/>
						</lvc:CartesianChart.Title>
						<lvc:CartesianChart.Series>
							<lvc:XamlColumnSeries Values="{Binding ColumnValues}" MaxBarWidth="24"/>
						</lvc:CartesianChart.Series>
						<lvc:CartesianChart.XAxes>
							<lvc:XamlDateTimeAxis
								Interval="1.00:00:00"
								DateFormatter="{Binding Formatter}"/>
						</lvc:CartesianChart.XAxes>
					</lvc:CartesianChart>
				</Border>
			</Grid>
		</Grid>
	</ScrollViewer>
</UserControl>
