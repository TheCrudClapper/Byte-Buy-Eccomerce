<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="clr-namespace:ByteBuy.UI.ViewModels"
			 xmlns:ordeline="clr-namespace:ByteBuy.UI.ViewModels.Order.OrderLine"
			 xmlns:delivery="clr-namespace:ByteBuy.UI.ViewModels.Order.OrderDelivery"
			 mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="800"
			 x:DataType="vm:OrderDetailsPageViewModel"
			 x:Class="ByteBuy.UI.Views.OrderDetailsPageView">

	<ScrollViewer>
		<Grid RowDefinitions="auto,*" Margin="0,10,30,30">

			<!-- Header: title + status + actions -->
			<Grid Grid.Row="0" ColumnDefinitions="*,auto" Margin="0,0,0,20">
				<StackPanel Spacing="6">
					<TextBlock Classes="pageTitle" Text="Order Details"/>
					<StackPanel Orientation="Horizontal" Spacing="8">
						<Image Width="20" Height="20" VerticalAlignment="Center">
							<Image.Source>
								<SvgImage Source="{Binding StatusIcon}"/>
							</Image.Source>
						</Image>
						<TextBlock Classes="headerText" Text="{Binding StatusText}" VerticalAlignment="Center"/>
						<TextBlock Classes="sectionHelperText" Text="•" VerticalAlignment="Center"/>
						<TextBlock Classes="sectionHelperText" Text="{Binding PurchasedDate}" VerticalAlignment="Center"/>
					</StackPanel>
				</StackPanel>

				<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
					<Button IsEnabled="{Binding CanShip}" Command="{Binding ShipOrderCommand}">
						<StackPanel Orientation="Horizontal" Spacing="8">
							<Image Source="{SvgImage /Assets/Images/regular/truck-solid-full.svg}" Width="16" Height="16"/>
							<TextBlock Text="Ship Order"/>
						</StackPanel>
					</Button>
					<Button IsEnabled="{Binding CanDeliver}" Command="{Binding DeliverOrderCommand}">
						<StackPanel Orientation="Horizontal" Spacing="8">
							<Image Source="{SvgImage /Assets/Images/regular/truck-ramp-box-solid-full.svg}" Width="16" Height="16"/>
							<TextBlock Text="Deliver Order"/>
						</StackPanel>
					</Button>
				</StackPanel>
			</Grid>

			<!-- Body -->
			<Grid Grid.Row="1" ColumnDefinitions="*,24,380">

				<!-- LEFT: items -->
				<Border Grid.Column="0" Classes="sectionBorder" Padding="28,24" VerticalAlignment="Top">
					<StackPanel Spacing="16">

						<Grid ColumnDefinitions="*,auto">
							<StackPanel Orientation="Horizontal" Spacing="8">
								<Image Classes="sectionMarker" VerticalAlignment="Center"
									   Source="{SvgImage /Assets/Images/regular/square-solid-full-primary.svg}"/>
								<TextBlock Text="Items" Classes="sectionLabel" VerticalAlignment="Center"/>
							</StackPanel>

							<TextBlock Grid.Column="1" Classes="sectionHelperText" VerticalAlignment="Center">
								<Run Text="{Binding LinesCount}"/>
								<Run Text="item/s from"/>
								<Run Text="{Binding SellerDisplayName}" FontWeight="Bold"/>
							</TextBlock>
						</Grid>

						<ItemsControl ItemsSource="{Binding Lines}">
							<ItemsControl.DataTemplates>

								<!-- Sale order line -->
								<DataTemplate DataType="{x:Type ordeline:SaleOrderLineViewModel}">
									<Border Classes="lineBorder"
											BorderBrush="{DynamicResource GrayAccentBrush}"
											CornerRadius="10"
											Padding="12"
											Margin="0,0,0,10">
										<Grid ColumnDefinitions="72,*,auto" ColumnSpacing="16">
											<Border Classes="imageTile" Width="72" Height="72">
												<Image Stretch="UniformToFill" Source="{Binding Thumbnail.Preview}"/>
											</Border>

											<StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
												<TextBlock Classes="standardText bold"
														   Text="{Binding ItemTitle}"
														   TextTrimming="CharacterEllipsis"/>
												<TextBlock Classes="sectionHelperText">
													<Run Text="{Binding Quantity}"/>
													<Run Text="x"/>
													<Run Text="{Binding PricePerItem.Display}"/>
												</TextBlock>
											</StackPanel>

											<TextBlock Grid.Column="2"
													   Classes="headerText bold"
													   VerticalAlignment="Center"
													   Text="{Binding Total.Display}"/>
										</Grid>
									</Border>
								</DataTemplate>

								<!-- Rent order line -->
								<DataTemplate DataType="{x:Type ordeline:RentOrderLineViewModel}">
									<Border Classes="lineBorder"
											BorderBrush="{DynamicResource GrayAccentBrush}"
											CornerRadius="10"
											Padding="12"
											Margin="0,0,0,10">
										<Grid ColumnDefinitions="72,*,auto" ColumnSpacing="16">
											<Border Classes="imageTile" Width="72" Height="72">
												<Image Stretch="UniformToFill" Source="{Binding Thumbnail.Preview}"/>
											</Border>

											<StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
												<TextBlock Classes="standardText bold"
														   Text="{Binding ItemTitle}"
														   TextTrimming="CharacterEllipsis"/>
												<TextBlock Classes="sectionHelperText">
													<Run Text="{Binding Quantity}"/>
													<Run Text="x"/>
													<Run Text="{Binding RentalDays}"/>
													<Run Text="days x"/>
													<Run Text="{Binding PricePerDay.Display}"/>
												</TextBlock>
											</StackPanel>

											<TextBlock Grid.Column="2"
													   Classes="headerText bold"
													   VerticalAlignment="Center"
													   Text="{Binding Total.Display}"/>
										</Grid>
									</Border>
								</DataTemplate>

							</ItemsControl.DataTemplates>
						</ItemsControl>
					</StackPanel>
				</Border>

				<!-- RIGHT: summary, recipient, delivery -->
				<StackPanel Grid.Column="2" Spacing="20">

					<!-- Summary -->
					<Border Classes="sectionBorder" Padding="24">
						<StackPanel Spacing="14">
							<StackPanel Orientation="Horizontal" Spacing="8">
								<Image Classes="sectionMarker" VerticalAlignment="Center"
									   Source="{SvgImage /Assets/Images/regular/square-solid-full-primary.svg}"/>
								<TextBlock Text="Summary" Classes="sectionLabel" VerticalAlignment="Center"/>
							</StackPanel>

							<Grid ColumnDefinitions="*,auto" RowDefinitions="auto,auto" RowSpacing="10">
								<TextBlock Grid.Row="0" Classes="standardText" Text="Items"/>
								<TextBlock Grid.Row="0" Grid.Column="1" Classes="standardText"
										   Text="{Binding TotalItemsCost.Display}"/>

								<StackPanel Grid.Row="1" Spacing="2">
									<TextBlock Classes="standardText" Text="Shipment"/>
									<TextBlock Classes="fieldLabel" Text="{Binding OrderDelivery.DeliveryName}"/>
								</StackPanel>
								<TextBlock Grid.Row="1" Grid.Column="1" Classes="standardText"
										   VerticalAlignment="Top"
										   Text="{Binding OrderDelivery.Price.Display}"/>
							</Grid>

							<Border Height="1" Opacity="0.2"
									Background="{DynamicResource PrimaryAccentBrush}"/>

							<Grid ColumnDefinitions="*,auto">
								<TextBlock Classes="headerText bold" Text="Total" VerticalAlignment="Center"/>
								<TextBlock Grid.Column="1" Classes="cardStat"
										   Text="{Binding TotalCost.Display}"/>
							</Grid>

							<Button Command="{Binding DownloadPdfCommand}"
									IsVisible="{Binding CanGeneratePdf}"
									HorizontalAlignment="Stretch"
									Margin="0,6,0,0">
								<StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
									<Image Source="{SvgImage /Assets/Images/regular/file-pdf-regular-full.svg}"
										   Width="16" Height="16"/>
									<TextBlock Text="Export to PDF"/>
								</StackPanel>
							</Button>
						</StackPanel>
					</Border>

					<!-- Recipient -->
					<Border Classes="sectionBorder" Padding="24">
						<StackPanel Spacing="14">
							<StackPanel Orientation="Horizontal" Spacing="8">
								<Image Classes="sectionMarker" VerticalAlignment="Center"
									   Source="{SvgImage /Assets/Images/regular/square-solid-full-primary.svg}"/>
								<TextBlock Text="Recipient" Classes="sectionLabel" VerticalAlignment="Center"/>
							</StackPanel>

							<StackPanel Spacing="3">
								<TextBlock Classes="standardText bold" Text="{Binding Buyer.FullName}"/>
								<TextBlock Classes="standardText" Text="{Binding Buyer.PhoneNumber}"/>
								<TextBlock Classes="standardText" Text="{Binding Buyer.Email}"
										   TextTrimming="CharacterEllipsis"/>
							</StackPanel>

							<StackPanel Spacing="3">
								<TextBlock Classes="fieldLabel" Text="Address"/>
								<TextBlock Classes="standardText">
									<Run Text="{Binding Buyer.HomeAddress.Street}"/>
									<Run Text="{Binding Buyer.HomeAddress.HouseNumber}"/>
									<Run Text="{Binding Buyer.HomeAddress.FlatNumber}"/>
									<Run Text=","/>
									<Run Text="{Binding Buyer.HomeAddress.City}"/>
								</TextBlock>
								<TextBlock Classes="standardText">
									<Run Text="{Binding Buyer.HomeAddress.PostalCode}"/>
									<Run Text="{Binding Buyer.HomeAddress.PostalCity}"/>
									<Run Text="{Binding Buyer.HomeAddress.Country}"/>
								</TextBlock>
							</StackPanel>
						</StackPanel>
					</Border>

					<!-- Delivery -->
					<Border Classes="sectionBorder" Padding="24">
						<StackPanel Spacing="14">
							<StackPanel Orientation="Horizontal" Spacing="8">
								<Image Classes="sectionMarker" VerticalAlignment="Center"
									   Source="{SvgImage /Assets/Images/regular/square-solid-full-primary.svg}"/>
								<TextBlock Text="Delivery" Classes="sectionLabel" VerticalAlignment="Center"/>
							</StackPanel>

							<Grid ColumnDefinitions="*,*" ColumnSpacing="16">
								<StackPanel Spacing="2">
									<TextBlock Classes="fieldLabel" Text="Method"/>
									<TextBlock Classes="standardText" Text="{Binding OrderDelivery.DeliveryName}"/>
								</StackPanel>
								<StackPanel Grid.Column="1" Spacing="2">
									<TextBlock Classes="fieldLabel" Text="Carrier code"/>
									<TextBlock Classes="standardText" Text="{Binding OrderDelivery.CarrierCode}"/>
								</StackPanel>
							</Grid>

							<StackPanel Spacing="3">
								<TextBlock Classes="fieldLabel" Text="Destination"/>

								<ContentControl Content="{Binding OrderDelivery}">
									<ContentControl.DataTemplates>

										<!-- Courier -->
										<DataTemplate DataType="{x:Type delivery:CourierDeliveryViewModel}">
											<StackPanel Spacing="3">
												<TextBlock Classes="standardText">
													<Run Text="{Binding Street}"/>
													<Run Text="{Binding HouseNumber}"/>
													<Run Text="{Binding FlatNumber}"/>
													<Run Text=","/>
													<Run Text="{Binding City}"/>
												</TextBlock>
												<TextBlock Classes="standardText">
													<Run Text="{Binding PostalCode}"/>
													<Run Text="{Binding PostalCity}"/>
												</TextBlock>
											</StackPanel>
										</DataTemplate>

										<!-- Parcel locker -->
										<DataTemplate DataType="{x:Type delivery:ParcelLockerDeliveryViewModel}">
											<TextBlock Classes="standardText" Text="{Binding ParcelLockerId}"/>
										</DataTemplate>

										<!-- Pickup point -->
										<DataTemplate DataType="{x:Type delivery:PickupPointDeliveryViewModel}">
											<StackPanel Spacing="3">
												<TextBlock Classes="standardText">
													<Run Text="{Binding PickupPointName}" FontWeight="Bold"/>
													<Run Text="·"/>
													<Run Text="{Binding PickupPointId}"/>
												</TextBlock>
												<TextBlock Classes="standardText">
													<Run Text="{Binding PickupStreet}"/>
													<Run Text="{Binding PickupLocalNumber}"/>
													<Run Text=","/>
													<Run Text="{Binding PickupCity}"/>
												</TextBlock>
											</StackPanel>
										</DataTemplate>

									</ContentControl.DataTemplates>
								</ContentControl>
							</StackPanel>
						</StackPanel>
					</Border>

				</StackPanel>
			</Grid>
		</Grid>
	</ScrollViewer>
</UserControl>