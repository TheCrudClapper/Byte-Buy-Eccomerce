<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="clr-namespace:ByteBuy.UI.ViewModels"
			 xmlns:ordeline="clr-namespace:ByteBuy.UI.ViewModels.Order.OrderLine"
			 xmlns:delivery="clr-namespace:ByteBuy.UI.ViewModels.Order.OrderDelivery"
			 mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="800"
			 x:DataType="vm:OrderDetailsPageViewModel"
			 x:Class="ByteBuy.UI.Views.OrderDetailsPageView">

	<ScrollViewer>
		<Grid ColumnDefinitions="*,24,400" Margin="0,20,30,30">

			<!-- ========== LEFT: header + items ========== -->
			<StackPanel Grid.Column="0" Spacing="22">

				<!-- Header: title + status + actions -->
				<Grid ColumnDefinitions="*,auto">
					<StackPanel Spacing="10">
						<TextBlock Classes="pageTitle" Text="Order Details"/>

						<StackPanel Orientation="Horizontal" Spacing="12">
							<Image Width="24" Height="24" VerticalAlignment="Center">
								<Image.Source>
									<SvgImage Source="{Binding StatusIcon}"/>
								</Image.Source>
							</Image>

							<Border Classes="statusPill"
									Classes.success="{Binding StatusText, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Delivered}"
									VerticalAlignment="Center">
								<TextBlock Text="{Binding StatusText}"/>
							</Border>

							<TextBlock Classes="sectionHelperText" VerticalAlignment="Center" Text="|"/>

							<TextBlock Classes="sectionHelperText"
									   VerticalAlignment="Center"
									   Text="{Binding PurchasedDate}"/>
						</StackPanel>
					</StackPanel>

					<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Top">
						<Button IsEnabled="{Binding CanShip}" Command="{Binding ShipOrderCommand}">
							<StackPanel Orientation="Horizontal" Spacing="8">
								<Image Source="{SvgImage /Assets/Images/regular/truck-solid-full.svg}" Width="16" Height="16"/>
								<TextBlock Text="Ship Order"/>
							</StackPanel>
						</Button>
						<Button IsEnabled="{Binding CanDeliver}" Command="{Binding DeliverOrderCommand}">
							<StackPanel Orientation="Horizontal" Spacing="8">
								<Image Source="{SvgImage /Assets/Images/regular/truck-ramp-box-solid-full.svg}" Width="16" Height="16"/>
								<TextBlock Text="Deliver Order"/>
							</StackPanel>
						</Button>
					</StackPanel>
				</Grid>

				<!-- Items card -->
				<Border Classes="sectionBorder" Padding="24">
					<StackPanel Spacing="18">

						<Grid ColumnDefinitions="*,auto">
							<StackPanel Orientation="Horizontal" Spacing="14">
								<Border Classes="sectionIcon">
									<PathIcon Data="{DynamicResource IconBox}"/>
								</Border>
								<TextBlock Text="Items" Classes="sectionLabel" VerticalAlignment="Center"/>
							</StackPanel>

							<TextBlock Grid.Column="1" Classes="sectionHelperText" VerticalAlignment="Center"><Run Text="{Binding LinesCount}"/><Run Text=" item/s | from "/><Run Text="{Binding SellerDisplayName}" FontWeight="Bold"/></TextBlock>
						</Grid>

						<ItemsControl ItemsSource="{Binding Lines}">
							<ItemsControl.DataTemplates>

								<!-- Sale order line -->
								<DataTemplate DataType="{x:Type ordeline:SaleOrderLineViewModel}">
									<Border Classes="itemRow" Margin="0,0,0,12">
										<Grid ColumnDefinitions="88,*,auto" ColumnSpacing="18">
											<Border Classes="imageTile" Width="88" Height="88">
												<Image Stretch="UniformToFill" Source="{Binding Thumbnail.Preview}"/>
											</Border>

											<StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
												<TextBlock Classes="headerText"
														   FontSize="18"
														   Text="{Binding ItemTitle}"
														   TextTrimming="CharacterEllipsis"/>
												<TextBlock Classes="sectionHelperText"><Run Text="{Binding Quantity}"/><Run Text=" x "/><Run Text="{Binding PricePerItem.Display}"/></TextBlock>
											</StackPanel>

											<TextBlock Grid.Column="2"
													   Classes="headerText"
													   FontSize="18"
													   Margin="0,0,12,0"
													   VerticalAlignment="Center"
													   Text="{Binding Total.Display}"/>
										</Grid>
									</Border>
								</DataTemplate>

								<!-- Rent order line -->
								<DataTemplate DataType="{x:Type ordeline:RentOrderLineViewModel}">
									<Border Classes="itemRow" Margin="0,0,0,12">
										<Grid ColumnDefinitions="88,*,auto" ColumnSpacing="18">
											<Border Classes="imageTile" Width="88" Height="88">
												<Image Stretch="UniformToFill" Source="{Binding Thumbnail.Preview}"/>
											</Border>

											<StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
												<TextBlock Classes="headerText"
														   FontSize="18"
														   Text="{Binding ItemTitle}"
														   TextTrimming="CharacterEllipsis"/>
												<TextBlock Classes="sectionHelperText"><Run Text="{Binding Quantity}"/><Run Text=" x "/><Run Text="{Binding RentalDays}"/><Run Text=" days x "/><Run Text="{Binding PricePerDay.Display}"/></TextBlock>
											</StackPanel>

											<TextBlock Grid.Column="2"
													   Classes="headerText"
													   FontSize="18"
													   Margin="0,0,12,0"
													   VerticalAlignment="Center"
													   Text="{Binding Total.Display}"/>
										</Grid>
									</Border>
								</DataTemplate>

							</ItemsControl.DataTemplates>
						</ItemsControl>
					</StackPanel>
				</Border>
			</StackPanel>

			<!-- ========== RIGHT: summary, recipient, delivery ========== -->
			<StackPanel Grid.Column="2" Spacing="16" Margin="0,8,0,0">

				<!-- Summary -->
				<Border Classes="sectionBorder" Padding="24">
					<StackPanel Spacing="16">
						<StackPanel Orientation="Horizontal" Spacing="14">
							<Border Classes="sectionIcon">
								<PathIcon Data="{DynamicResource IconDocument}"/>
							</Border>
							<TextBlock Text="Summary" Classes="sectionLabel" VerticalAlignment="Center"/>
						</StackPanel>

						<Grid ColumnDefinitions="*,auto" RowDefinitions="auto,auto" RowSpacing="12">
							<TextBlock Grid.Row="0" Classes="standardText" Text="Items"/>
							<TextBlock Grid.Row="0" Grid.Column="1" Classes="standardText"
									   Text="{Binding TotalItemsCost.Display}"/>

							<StackPanel Grid.Row="1" Spacing="2">
								<TextBlock Classes="standardText" Text="Shipment"/>
								<TextBlock Classes="sectionHelperText" Text="{Binding OrderDelivery.DeliveryName}"/>
							</StackPanel>
							<TextBlock Grid.Row="1" Grid.Column="1" Classes="standardText"
									   VerticalAlignment="Top"
									   Text="{Binding OrderDelivery.Price.Display}"/>
						</Grid>

						<Border Classes="divider"/>

						<Grid ColumnDefinitions="*,auto">
							<TextBlock Classes="headerText" Text="Total" VerticalAlignment="Center"/>
							<TextBlock Grid.Column="1" Classes="cardStat"
									   Text="{Binding TotalCost.Display}"/>
						</Grid>

						<Button Classes="accent"
								Command="{Binding DownloadPdfCommand}"
								IsVisible="{Binding CanGeneratePdf}"
								HorizontalAlignment="Stretch">
							<StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
								<PathIcon Width="16" Height="16" Foreground="White"
										  Data="{DynamicResource IconUpload}"/>
								<TextBlock Text="Export to PDF" Foreground="White"/>
							</StackPanel>
						</Button>
					</StackPanel>
				</Border>

				<!-- Recipient -->
				<Border Classes="sectionBorder" Padding="24">
					<StackPanel Spacing="16">
						<StackPanel Orientation="Horizontal" Spacing="14">
							<Border Classes="sectionIcon">
								<PathIcon Data="{DynamicResource IconPerson}"/>
							</Border>
							<TextBlock Text="Recipient" Classes="sectionLabel" VerticalAlignment="Center"/>
						</StackPanel>

						<StackPanel Spacing="4">
							<TextBlock Classes="headerText" Text="{Binding Buyer.FullName}"/>
							<TextBlock Classes="standardText" Text="{Binding Buyer.PhoneNumber}"/>
							<TextBlock Classes="standardText"
									   Text="{Binding Buyer.Email}"
									   TextTrimming="CharacterEllipsis"/>
						</StackPanel>

						<Border Classes="divider"/>

						<Grid ColumnDefinitions="auto,*" ColumnSpacing="12">
							<PathIcon Width="18" Height="18"
									  VerticalAlignment="Top"
									  Margin="0,2,0,0"
									  Foreground="{DynamicResource PrimaryAccentBrush}"
									  Data="{DynamicResource IconPin}"/>

							<StackPanel Grid.Column="1" Spacing="3">
								<TextBlock Classes="sectionHelperText"><Run Text="{Binding Buyer.HomeAddress.Street}"/><Run Text=" "/><Run Text="{Binding Buyer.HomeAddress.HouseNumber}"/><Run Text=" "/><Run Text="{Binding Buyer.HomeAddress.FlatNumber}"/></TextBlock>
								<TextBlock Classes="sectionHelperText"><Run Text="{Binding Buyer.HomeAddress.PostalCode}"/><Run Text=" "/><Run Text="{Binding Buyer.HomeAddress.PostalCity}"/></TextBlock>
								<TextBlock Classes="sectionHelperText"><Run Text="{Binding Buyer.HomeAddress.City}"/><Run Text=", "/><Run Text="{Binding Buyer.HomeAddress.Country}"/></TextBlock>
							</StackPanel>
						</Grid>
					</StackPanel>
				</Border>

				<!-- Delivery -->
				<Border Classes="sectionBorder" Padding="24">
					<StackPanel Spacing="16">
						<StackPanel Orientation="Horizontal" Spacing="14">
							<Border Classes="sectionIcon">
								<PathIcon Data="{DynamicResource IconTruck}"/>
							</Border>
							<TextBlock Text="Delivery" Classes="sectionLabel" VerticalAlignment="Center"/>
						</StackPanel>

						<Grid ColumnDefinitions="*,auto" ColumnSpacing="16">
							<StackPanel Spacing="3">
								<TextBlock Classes="sectionHelperText" Text="Method"/>
								<TextBlock Classes="standardText" Text="{Binding OrderDelivery.DeliveryName}"/>
							</StackPanel>
							<StackPanel Grid.Column="1" Spacing="3">
								<TextBlock Classes="sectionHelperText" Text="Carrier code"/>
								<TextBlock Classes="standardText" Text="{Binding OrderDelivery.CarrierCode}"/>
							</StackPanel>
						</Grid>

						<StackPanel Spacing="3">
							<TextBlock Classes="sectionHelperText" Text="Destination"/>

							<ContentControl Content="{Binding OrderDelivery}">
								<ContentControl.DataTemplates>

									<!-- Courier -->
									<DataTemplate DataType="{x:Type delivery:CourierDeliveryViewModel}">
										<StackPanel Spacing="2">
											<TextBlock Classes="standardText"><Run Text="{Binding Street}"/><Run Text=" "/><Run Text="{Binding HouseNumber}"/><Run Text=" "/><Run Text="{Binding FlatNumber}"/></TextBlock>
											<TextBlock Classes="standardText"><Run Text="{Binding PostalCode}"/><Run Text=" "/><Run Text="{Binding PostalCity}"/></TextBlock>
											<TextBlock Classes="standardText" Text="{Binding City}"/>
										</StackPanel>
									</DataTemplate>

									<!-- Parcel locker -->
									<DataTemplate DataType="{x:Type delivery:ParcelLockerDeliveryViewModel}">
										<TextBlock Classes="standardText" Text="{Binding ParcelLockerId}"/>
									</DataTemplate>

									<!-- Pickup point -->
									<DataTemplate DataType="{x:Type delivery:PickupPointDeliveryViewModel}">
										<StackPanel Spacing="2">
											<TextBlock Classes="standardText"><Run Text="{Binding PickupPointName}" FontWeight="Bold"/><Run Text=" · "/><Run Text="{Binding PickupPointId}"/></TextBlock>
											<TextBlock Classes="standardText"><Run Text="{Binding PickupStreet}"/><Run Text=" "/><Run Text="{Binding PickupLocalNumber}"/><Run Text=", "/><Run Text="{Binding PickupCity}"/></TextBlock>
										</StackPanel>
									</DataTemplate>

								</ContentControl.DataTemplates>
							</ContentControl>
						</StackPanel>
					</StackPanel>
				</Border>

			</StackPanel>
		</Grid>
	</ScrollViewer>
</UserControl>