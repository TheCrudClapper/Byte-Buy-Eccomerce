<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="clr-namespace:ByteBuy.UI.ViewModels"
			 mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="600"
			 x:Class="ByteBuy.UI.Views.RentalDetailsPageView"
			 x:DataType="vm:RentalDetailsPageViewModel">

	<ScrollViewer>
		<Grid RowDefinitions="auto,*" Margin="0,10,30,30">

			<!-- Header: title + status + created date -->
			<StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,20">
				<TextBlock Classes="pageTitle" Text="Rental Details"/>
				<StackPanel Orientation="Horizontal" Spacing="8">
					<Image Width="20" Height="20" VerticalAlignment="Center">
						<Image.Source>
							<SvgImage Source="{Binding RentalIcon}"/>
						</Image.Source>
					</Image>
					<TextBlock Classes="headerText" Text="{Binding RentalStatusText}" VerticalAlignment="Center"/>
					<TextBlock Classes="sectionHelperText" Text="•" VerticalAlignment="Center"/>
					<TextBlock Classes="sectionHelperText" VerticalAlignment="Center">
						<Run Text="Created"/>
						<Run Text="{Binding DateCreated}"/>
					</TextBlock>
				</StackPanel>
			</StackPanel>

			<!-- Body -->
			<Grid Grid.Row="1" ColumnDefinitions="*,24,380">

				<!-- LEFT: item + period -->
				<StackPanel Grid.Column="0" Spacing="20" VerticalAlignment="Top">

					<!-- Rented item -->
					<Border Classes="sectionBorder" Padding="28,24">
						<StackPanel Spacing="16">
							<StackPanel Orientation="Horizontal" Spacing="8">
								<Image Classes="sectionMarker" VerticalAlignment="Center"
									   Source="{SvgImage /Assets/Images/regular/square-solid-full-primary.svg}"/>
								<TextBlock Text="Rented Item" Classes="sectionLabel" VerticalAlignment="Center"/>
							</StackPanel>

							<Border Classes="lineBorder"
									BorderBrush="{DynamicResource GrayAccentBrush}"
									CornerRadius="10"
									Padding="12">
								<Grid ColumnDefinitions="72,*" ColumnSpacing="16">
									<Border Classes="imageTile" Width="72" Height="72">
										<Image Stretch="UniformToFill" Source="{Binding ImageThumbnail.Preview}"/>
									</Border>

									<StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
										<TextBlock Classes="standardText bold"
												   Text="{Binding ItemName}"
												   TextTrimming="CharacterEllipsis"/>
										<TextBlock Classes="sectionHelperText">
											<Run Text="Quantity:"/>
											<Run Text="{Binding Quantity}" FontWeight="Bold"/>
											<Run Text="unit/s"/>
										</TextBlock>
									</StackPanel>
								</Grid>
							</Border>
						</StackPanel>
					</Border>

					<!-- Rental period -->
					<Border Classes="sectionBorder" Padding="28,24">
						<StackPanel Spacing="14">
							<StackPanel Orientation="Horizontal" Spacing="8">
								<Image Classes="sectionMarker" VerticalAlignment="Center"
									   Source="{SvgImage /Assets/Images/regular/square-solid-full-primary.svg}"/>
								<TextBlock Text="Rental Period" Classes="sectionLabel" VerticalAlignment="Center"/>
							</StackPanel>

							<Grid ColumnDefinitions="*,*,*" ColumnSpacing="20">
								<StackPanel Spacing="2">
									<TextBlock Classes="fieldLabel" Text="From"/>
									<TextBlock Classes="standardText bold" Text="{Binding StartingRentalDate}"/>
								</StackPanel>
								<StackPanel Grid.Column="1" Spacing="2">
									<TextBlock Classes="fieldLabel" Text="To"/>
									<TextBlock Classes="standardText bold" Text="{Binding EndingRentalDate}"/>
								</StackPanel>
								<StackPanel Grid.Column="2" Spacing="2">
									<TextBlock Classes="fieldLabel" Text="Duration"/>
									<TextBlock Classes="standardText bold">
										<Run Text="{Binding RentalDays}"/>
										<Run Text="day/s"/>
									</TextBlock>
								</StackPanel>
							</Grid>
						</StackPanel>
					</Border>
				</StackPanel>

				<!-- RIGHT: borrower + payment -->
				<StackPanel Grid.Column="2" Spacing="20">

					<!-- Borrower -->
					<Border Classes="sectionBorder" Padding="24">
						<StackPanel Spacing="14">
							<StackPanel Orientation="Horizontal" Spacing="8">
								<Image Classes="sectionMarker" VerticalAlignment="Center"
									   Source="{SvgImage /Assets/Images/regular/square-solid-full-primary.svg}"/>
								<TextBlock Text="Borrower" Classes="sectionLabel" VerticalAlignment="Center"/>
							</StackPanel>

							<StackPanel Spacing="3">
								<TextBlock Classes="standardText bold" Text="{Binding BorrowerName}"/>
								<TextBlock Classes="standardText"
										   Text="{Binding BorrowerEmail}"
										   TextTrimming="CharacterEllipsis"/>
							</StackPanel>
						</StackPanel>
					</Border>

					<!-- Payment -->
					<Border Classes="sectionBorder" Padding="24">
						<StackPanel Spacing="14">
							<StackPanel Orientation="Horizontal" Spacing="8">
								<Image Classes="sectionMarker" VerticalAlignment="Center"
									   Source="{SvgImage /Assets/Images/regular/square-solid-full-primary.svg}"/>
								<TextBlock Text="Payment" Classes="sectionLabel" VerticalAlignment="Center"/>
							</StackPanel>

							<Border Height="1" Opacity="0.2"
									Background="{DynamicResource PrimaryAccentBrush}"/>

							<Grid ColumnDefinitions="*,auto">
								<TextBlock Classes="headerText bold" Text="Total Paid" VerticalAlignment="Center"/>
								<TextBlock Grid.Column="1" Classes="cardStat"
										   Text="{Binding TotalPricePaid.Display}"/>
							</Grid>
						</StackPanel>
					</Border>

				</StackPanel>
			</Grid>
		</Grid>
	</ScrollViewer>
</UserControl>