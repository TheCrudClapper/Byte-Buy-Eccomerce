<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="clr-namespace:ByteBuy.UI.ViewModels"
			 mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
			 x:Class="ByteBuy.UI.Views.RentalDetailsPageView"
			 x:DataType="vm:RentalDetailsPageViewModel">

	<ScrollViewer>
		<Grid ColumnDefinitions="*,24,400" Margin="0,20,30,30">

			<!-- ========== LEFT: header + item + period ========== -->
			<StackPanel Grid.Column="0" Spacing="22">

				<!-- Header: title + status + created date -->
				<StackPanel Spacing="10">
					<TextBlock Classes="pageTitle" Text="Rental Details"/>

					<StackPanel Orientation="Horizontal" Spacing="12">
						<Image Width="24" Height="24" VerticalAlignment="Center">
							<Image.Source>
								<SvgImage Source="{Binding RentalIcon}"/>
							</Image.Source>
						</Image>

						<Border Classes="statusPill" VerticalAlignment="Center">
							<TextBlock Text="{Binding RentalStatusText}"/>
						</Border>

						<TextBlock Classes="sectionHelperText" VerticalAlignment="Center" Text="|"/>

						<TextBlock Classes="sectionHelperText" VerticalAlignment="Center"><Run Text="Created "/><Run Text="{Binding DateCreated}"/></TextBlock>
					</StackPanel>
				</StackPanel>

				<!-- Rented item -->
				<Border Classes="sectionBorder" Padding="24">
					<StackPanel Spacing="18">

						<Grid ColumnDefinitions="*,auto">
							<StackPanel Orientation="Horizontal" Spacing="14">
								<Border Classes="sectionIcon">
									<PathIcon Data="{DynamicResource IconBox}"/>
								</Border>
								<TextBlock Text="Rented Item" Classes="sectionLabel" VerticalAlignment="Center"/>
							</StackPanel>

							<TextBlock Grid.Column="1" Classes="sectionHelperText" VerticalAlignment="Center"><Run Text="{Binding Quantity}"/><Run Text=" unit/s"/></TextBlock>
						</Grid>

						<Border Classes="itemRow">
							<Grid ColumnDefinitions="88,*,auto" ColumnSpacing="18">
								<Border Classes="imageTile" Width="88" Height="88">
									<Image Stretch="UniformToFill" Source="{Binding ImageThumbnail.Preview}"/>
								</Border>

								<StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
									<TextBlock Classes="headerText"
											   FontSize="18"
											   Text="{Binding ItemName}"
											   TextTrimming="CharacterEllipsis"/>
									<TextBlock Classes="sectionHelperText"><Run Text="Quantity: "/><Run Text="{Binding Quantity}" FontWeight="Bold"/></TextBlock>
								</StackPanel>

								<TextBlock Grid.Column="2"
										   Classes="headerText"
										   FontSize="18"
										   Margin="0,0,12,0"
										   VerticalAlignment="Center"><Run Text="{Binding RentalDays}"/><Run Text=" day/s"/></TextBlock>
							</Grid>
						</Border>
					</StackPanel>
				</Border>

				<!-- Rental period -->
				<Border Classes="sectionBorder" Padding="24">
					<StackPanel Spacing="18">
						<StackPanel Orientation="Horizontal" Spacing="14">
							<Border Classes="sectionIcon">
								<PathIcon Data="{DynamicResource IconCalendar}"/>
							</Border>
							<TextBlock Text="Rental Period" Classes="sectionLabel" VerticalAlignment="Center"/>
						</StackPanel>

						<Grid ColumnDefinitions="*,*,*" ColumnSpacing="20">
							<StackPanel Spacing="3">
								<TextBlock Classes="sectionHelperText" Text="From"/>
								<TextBlock Classes="headerText" Text="{Binding StartingRentalDate}"/>
							</StackPanel>
							<StackPanel Grid.Column="1" Spacing="3">
								<TextBlock Classes="sectionHelperText" Text="To"/>
								<TextBlock Classes="headerText" Text="{Binding EndingRentalDate}"/>
							</StackPanel>
							<StackPanel Grid.Column="2" Spacing="3">
								<TextBlock Classes="sectionHelperText" Text="Duration"/>
								<TextBlock Classes="headerText"><Run Text="{Binding RentalDays}"/><Run Text=" day/s"/></TextBlock>
							</StackPanel>
						</Grid>
					</StackPanel>
				</Border>
			</StackPanel>

			<!-- ========== RIGHT: summary + borrower ========== -->
			<StackPanel Grid.Column="2" Spacing="16" Margin="0,8,0,0">

				<!-- Summary -->
				<Border Classes="sectionBorder" Padding="24">
					<StackPanel Spacing="16">
						<StackPanel Orientation="Horizontal" Spacing="14">
							<Border Classes="sectionIcon">
								<PathIcon Data="{DynamicResource IconDocument}"/>
							</Border>
							<TextBlock Text="Summary" Classes="sectionLabel" VerticalAlignment="Center"/>
						</StackPanel>

						<Grid ColumnDefinitions="*,auto" RowDefinitions="auto,auto,auto" RowSpacing="12">
							<TextBlock Grid.Row="0" Classes="standardText" Text="Period"/>
							<TextBlock Grid.Row="0" Grid.Column="1" Classes="standardText"><Run Text="{Binding RentalDays}"/><Run Text=" day/s"/></TextBlock>

							<TextBlock Grid.Row="1" Classes="standardText" Text="Quantity"/>
							<TextBlock Grid.Row="1" Grid.Column="1" Classes="standardText"><Run Text="{Binding Quantity}"/><Run Text=" unit/s"/></TextBlock>

							<TextBlock Grid.Row="2" Classes="standardText" Text="Price per day"/>
							<TextBlock Grid.Row="2" Grid.Column="1" Classes="standardText" Text="{Binding PricePerDay.Display}"/>
						</Grid>

						<Border Classes="divider"/>

						<Grid ColumnDefinitions="*,auto">
							<TextBlock Classes="headerText" Text="Total Paid" VerticalAlignment="Center"/>
							<TextBlock Grid.Column="1" Classes="cardStat"
									   Text="{Binding TotalPricePaid.Display}"/>
						</Grid>
					</StackPanel>
				</Border>

				<!-- Borrower -->
				<Border Classes="sectionBorder" Padding="24">
					<StackPanel Spacing="16">
						<StackPanel Orientation="Horizontal" Spacing="14">
							<Border Classes="sectionIcon">
								<PathIcon Data="{DynamicResource IconPerson}"/>
							</Border>
							<TextBlock Text="Borrower" Classes="sectionLabel" VerticalAlignment="Center"/>
						</StackPanel>

						<StackPanel Spacing="4">
							<TextBlock Classes="headerText" Text="{Binding BorrowerName}"/>
							<TextBlock Classes="standardText"
									   Text="{Binding BorrowerEmail}"
									   TextTrimming="CharacterEllipsis"/>
						</StackPanel>
					</StackPanel>
				</Border>

			</StackPanel>
		</Grid>
	</ScrollViewer>
</UserControl>