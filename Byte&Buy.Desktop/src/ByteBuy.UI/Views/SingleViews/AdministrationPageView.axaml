
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ByteBuy.UI.ViewModels.SingleViewModels"
             xmlns:tabitems="clr-namespace:ByteBuy.UI.Views"
             Background="Transparent"
             mc:Ignorable="d"
             d:DesignWidth="1300"
             d:DesignHeight="800"
             x:Class="ByteBuy.UI.Views.SingleViews.AdministrationPageView"
             x:DataType="vm:AdministrationPageViewModel">

    <Grid RowDefinitions="auto,*"
          RowSpacing="20"
          Margin="0,10,30,30">

        <!-- Page Header -->
        <Grid Grid.Row="0"
              RowDefinitions="auto,auto"
              RowSpacing="6">

            <TextBlock Grid.Row="0"
                       Classes="pageTitle"
                       Text="Administration"/>

            <TextBlock Grid.Row="1"
                       Text="Manage deliveries, warehouse, categories and marketplace settings."
                       Classes="sectionHelperText"/>

        </Grid>

        <!-- Administration Tabs -->
            <TabControl Grid.Row="1" 
                        SelectedItem="{Binding SelectedTab}">

                <TabItem Header="Deliveries"
                         Content="{Binding DeliveriesPageViewModel}"/>

                <TabItem Header="Carriers"
                         Content="{Binding DeliveryCarriersPageViewModel}"/>

                <TabItem Header="Categories"
                         Content="{Binding CategoriesPageViewModel}"/>

                <TabItem Header="Conditions"
                         Content="{Binding ConditionsPageViewModel}"/>

                <TabItem Header="Countries"
                         Content="{Binding CountriesPageViewModel}"/>

                <TabItem Header="Warehouse Items"
                         Content="{Binding ItemsPageViewModel}"/>

                <TabItem Header="Sale Offers"
                         Content="{Binding SaleOffersViewModel}"/>

                <TabItem Header="Rental Offers"
                         Content="{Binding RentOffersViewModel}"/>

            </TabControl>
    </Grid>
</UserControl>
