<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:views="using:ByteBuy.UI.Views.Shared"
			 Background="Transparent"
			 xmlns:vm="clr-namespace:ByteBuy.UI.ViewModels"
			 mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="900"
			 x:Class="ByteBuy.UI.Views.ItemPageView"
			 x:DataType="vm:ItemPageViewModel">

	<Grid>
		<ScrollViewer>
			<Grid RowDefinitions="auto, auto" Margin="0,0,30,30">

				<!--Header-->
				<StackPanel Grid.Row="0" Margin="0,10,0,24" Spacing="2">
					<TextBlock Classes="pageTitle" Text="Warehouse Item"/>
					<TextBlock Classes="sectionHelperText"
							   Text="Fill in the details on the left, add photos on the right."/>
				</StackPanel>

				<!--Two column layout: form | images + actions-->
				<Grid Grid.Row="1" ColumnDefinitions="*, 540" ColumnSpacing="24">

					<!-- LEFT: form -->
					<StackPanel Grid.Column="0" Spacing="20">

						<!--Name and Stock Quantity-->
						<Border Classes="sectionBorder" Padding="24">
							<StackPanel Spacing="16">
								<StackPanel Spacing="2">
									<TextBlock Classes="sectionText" Text="Name and Stock Quantity"/>
									<TextBlock Classes="sectionHelperText"
											   IsVisible="{Binding !IsEditMode}"
											   Text="Provide name and stock quantity of item."/>
									<TextBlock Classes="sectionHelperText"
											   IsVisible="{Binding IsEditMode}"
											   Text="Provide name and additional stock quantity of item."/>
								</StackPanel>

								<Grid ColumnDefinitions="*,*" ColumnSpacing="16">
									<StackPanel Grid.Column="0" Spacing="6">
										<TextBlock Classes="fieldLabel" Text="Name"/>
										<TextBox Text="{Binding Name}" Watermark="e.g. Mechanical keyboard"
												 HorizontalAlignment="Stretch"/>
									</StackPanel>

									<!--Create mode-->
									<StackPanel Grid.Column="1" Spacing="6" IsVisible="{Binding !IsEditMode}">
										<TextBlock Classes="fieldLabel" Text="Stock quantity"/>
										<NumericUpDown Value="{Binding StockQuantity}"
													   HorizontalAlignment="Stretch"/>
									</StackPanel>

									<!--Edit mode-->
									<StackPanel Grid.Column="1" Spacing="6" IsVisible="{Binding IsEditMode}">
										<TextBlock Classes="fieldLabel" Text="Current  /  add"/>
										<Grid ColumnDefinitions="30*, 70*" ColumnSpacing="10">
											<TextBox Grid.Column="0" IsEnabled="false"
													 Text="{Binding CurrentStockQuantity}"
													 HorizontalAlignment="Stretch"/>
											<NumericUpDown Grid.Column="1" Value="{Binding StockQuantity}"
														   HorizontalAlignment="Stretch"/>
										</Grid>
									</StackPanel>
								</Grid>
							</StackPanel>
						</Border>

						<!--Category and condition-->
						<Border Classes="sectionBorder" Padding="24">
							<StackPanel Spacing="16">
								<StackPanel Spacing="2">
									<TextBlock Classes="sectionText" Text="Category and Condition"/>
									<TextBlock Classes="sectionHelperText"
											   Text="Choose category and condition of your item."/>
								</StackPanel>

								<Grid ColumnDefinitions="*,*" ColumnSpacing="16">
									<StackPanel Grid.Column="0" Spacing="6">
										<TextBlock Classes="fieldLabel" Text="Category"/>
										<ComboBox Classes="wideCombo"
												  ItemsSource="{Binding Categories}"
												  SelectedItem="{Binding SelectedCategory, Mode=TwoWay}">
											<ComboBox.ItemTemplate>
												<DataTemplate>
													<TextBlock Text="{Binding Title}"/>
												</DataTemplate>
											</ComboBox.ItemTemplate>
										</ComboBox>
									</StackPanel>

									<StackPanel Grid.Column="1" Spacing="6">
										<TextBlock Classes="fieldLabel" Text="Condition"/>
										<ComboBox Classes="wideCombo"
												  ItemsSource="{Binding Conditions}"
												  SelectedItem="{Binding SelectedCondition, Mode=TwoWay}">
											<ComboBox.ItemTemplate>
												<DataTemplate>
													<TextBlock Text="{Binding Title}"/>
												</DataTemplate>
											</ComboBox.ItemTemplate>
										</ComboBox>
									</StackPanel>
								</Grid>
							</StackPanel>
						</Border>

						<!--Description-->
						<Border Classes="sectionBorder" Padding="24">
							<StackPanel Spacing="16">
								<Grid ColumnDefinitions="*, auto">
									<StackPanel Spacing="2">
										<TextBlock Classes="sectionText" Text="Description"/>
										<TextBlock Classes="sectionHelperText"
												   Text="Describe the item, its pros and cons to avoid customer questions."/>
									</StackPanel>
									<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
										<TextBlock Classes="sectionHelperText" Text="{Binding DescriptionCharCount}"/>
										<TextBlock Classes="sectionHelperText" Text=" / 2000"/>
									</StackPanel>
								</Grid>

								<TextBox Text="{Binding Description}"
										 AcceptsReturn="True"
										 TextWrapping="Wrap"
										 HorizontalAlignment="Stretch"
										 Height="260"/>
							</StackPanel>
						</Border>
					</StackPanel>

					<!-- RIGHT: images + actions -->
					<StackPanel Grid.Column="1" Spacing="20">

						<!--Images-->
						<Border Classes="sectionBorder" Padding="24">
							<StackPanel Spacing="16">
								<Grid ColumnDefinitions="*, auto">
									<StackPanel Spacing="2">
										<TextBlock Classes="sectionText" Text="Images"/>
										<TextBlock Classes="sectionHelperText" Text="Add photos and alt texts."/>
									</StackPanel>
									<Button Grid.Column="1"
											Command="{Binding AddImagesCommand}"
											VerticalAlignment="Top"
											Padding="12,6">
										<StackPanel Orientation="Horizontal" Spacing="6">
											<Image Source="{SvgImage /Assets/Images/regular/plus-solid-full.svg}"
												   Width="12" Height="12" VerticalAlignment="Center"/>
											<TextBlock Text="Add" VerticalAlignment="Center"/>
										</StackPanel>
									</Button>
								</Grid>

								<!--Drop zone-->
								<Border Classes="highlightable dropZone"
										MinHeight="220"
										DragDrop.AllowDrop="True">
									<Grid>
										<!--Empty state-->
										<StackPanel VerticalAlignment="Center"
													HorizontalAlignment="Center"
													Spacing="8"
													IsVisible="{Binding ImageContainerVisible}">
											<Image Height="48" Width="48"
												   Source="{SvgImage /Assets/Images/regular/images-regular-full.svg}"/>
											<TextBlock Text="No images yet"
													   HorizontalAlignment="Center"
													   FontSize="18"
													   FontFamily="{DynamicResource OpenSansBold}"
													   Foreground="{DynamicResource TextPrimaryBrush}"/>
											<TextBlock Classes="sectionHelperText"
													   HorizontalAlignment="Center"
													   TextAlignment="Center"
													   Text="Click Add or drop files here."/>
										</StackPanel>

										<!--Thumbnails-->
										<ItemsControl ItemsSource="{Binding Images}" Margin="12">
											<ItemsControl.ItemsPanel>
												<ItemsPanelTemplate>
													<UniformGrid Columns="2" ColumnSpacing="12" RowSpacing="12"/>
												</ItemsPanelTemplate>
											</ItemsControl.ItemsPanel>
											<ItemsControl.ItemTemplate>
												<DataTemplate>
													<StackPanel IsVisible="{Binding !IsDeleted}" Spacing="6">
														<Border Classes="imageTile" Height="200">
															<Grid>
																<Image Stretch="UniformToFill" Width="225" Height="225" Source="{Binding Preview}"/>
																<Button Classes="deleteBadge"
																		HorizontalAlignment="Right"
																		VerticalAlignment="Top"
																		Margin="6"
																		x:CompileBindings="false"
																		Command="{Binding DataContext.DeleteImageCommand,
																		RelativeSource={RelativeSource AncestorType=UserControl}}"
																		CommandParameter="{Binding}">
																	<Image Source="{SvgImage /Assets/Images/regular/trash-can-solid-full.svg}"
																		   Height="14" Width="14"/>
																</Button>
															</Grid>
														</Border>
														<TextBox FontSize="12"
																 HorizontalAlignment="Stretch"
																 Watermark="Alternative text"
																 Text="{Binding AltText}"/>
													</StackPanel>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>
									</Grid>
								</Border>
							</StackPanel>
						</Border>

						<!--Actions-->
						<Border Classes="sectionBorder" Padding="20">
							<Grid ColumnDefinitions="*,*" ColumnSpacing="12">
								<Button Grid.Column="0" Content="Clear"
										Command="{Binding ClearCommand}"
										HorizontalAlignment="Stretch"
										HorizontalContentAlignment="Center"/>
								<Button Grid.Column="1" Content="Save"
										Command="{Binding SaveCommand}"
										HorizontalAlignment="Stretch"
										HorizontalContentAlignment="Center"/>
							</Grid>
						</Border>
					</StackPanel>
				</Grid>
			</Grid>
		</ScrollViewer>
	</Grid>
</UserControl>
