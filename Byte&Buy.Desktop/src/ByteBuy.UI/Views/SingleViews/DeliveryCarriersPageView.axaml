<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="clr-namespace:ByteBuy.UI.ViewModels"
			 xmlns:views="clr-namespace:ByteBuy.UI.Views.Shared"
			 Background="Transparent"
			 mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="600"
			 x:DataType="vm:DeliveryCarriersViewModel"
			 x:Class="ByteBuy.UI.Views.DeliveryCarriersView">

	<!-- Tab page: one card, no page title and no outer margin (the parent page provides them) -->
	<Border Padding="24,20">
		<Grid RowDefinitions="auto,auto,auto,*,auto" RowSpacing="16">

			<!-- Header: icon + name, records count, add -->
			<Grid Grid.Row="0" ColumnDefinitions="*,auto,auto" ColumnSpacing="20">
				<StackPanel Orientation="Horizontal" Spacing="14">
					<Border Classes="sectionIcon">
						<PathIcon Data="{DynamicResource IconTruck}"/>
					</Border>
					<StackPanel VerticalAlignment="Center" Spacing="2">
						<TextBlock Text="Delivery Carriers" Classes="sectionLabel"/>
						<TextBlock Text="Companies that handle your shipments." Classes="sectionHelperText"/>
					</StackPanel>
				</StackPanel>

				<TextBlock Grid.Column="1" Classes="sectionHelperText" VerticalAlignment="Center"><Run Text="Records fetched: "/><Run Text="{Binding ItemsCount}" FontWeight="Bold"/></TextBlock>

				<Button Grid.Column="2" Classes="accent" Command="{Binding AddCommand}">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<Image Source="{SvgImage /Assets/Images/regular/plus-solid-full.svg}"
							   Width="15" Height="15"/>
						<TextBlock Text="Add" Foreground="White"/>
					</StackPanel>
				</Button>
			</Grid>

			<!-- Filter toolbar -->
			<WrapPanel Grid.Row="1" Orientation="Horizontal" ItemSpacing="16" LineSpacing="12">
				<StackPanel Spacing="6">
					<TextBlock Text="Carrier Name" Classes="textBoxLabel"/>
					<TextBox Width="220" Text="{Binding DeliveryCarrierName}" Watermark="Search by name">
						<TextBox.KeyBindings>
							<KeyBinding Gesture="Enter" Command="{Binding LoadDataCommand}"/>
						</TextBox.KeyBindings>
					</TextBox>
				</StackPanel>

				<StackPanel Spacing="6">
					<TextBlock Text="Code" Classes="textBoxLabel"/>
					<TextBox Width="160" Text="{Binding Code}">
						<TextBox.KeyBindings>
							<KeyBinding Gesture="Enter" Command="{Binding LoadDataCommand}"/>
						</TextBox.KeyBindings>
					</TextBox>
				</StackPanel>

				<StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom">
					<Button Classes="accent filterButton" Padding="16,0" Command="{Binding LoadDataCommand}">
						<StackPanel Orientation="Horizontal" Spacing="8">
							<Image Source="{SvgImage /Assets/Images/regular/filter-solid-full.svg}"
								   Width="15" Height="15"/>
							<TextBlock Text="Filter" Foreground="White"/>
						</StackPanel>
					</Button>

					<Button Classes="filterButton" Padding="16,0" Command="{Binding ClearFiltersCommand}">
						<StackPanel Orientation="Horizontal" Spacing="8">
							<Image Source="{SvgImage /Assets/Images/regular/filter-circle-xmark-solid-full.svg}"
								   Width="15" Height="15"/>
							<TextBlock Text="Clear"/>
						</StackPanel>
					</Button>
				</StackPanel>
			</WrapPanel>

			<Border Grid.Row="2" Classes="divider"/>

			<!-- Data Grid Containing All Items -->
			<DataGrid Grid.Row="3"
					  x:Name="ItemsGrid"
					  ItemsSource="{Binding Items}"
					  SelectedItem="{Binding SelectedItem}"
					  AutoGenerateColumns="False"
					  GridLinesVisibility="Horizontal"
					  IsReadOnly="True"
					  HeadersVisibility="Column"
					  CanUserSortColumns="True"
					  CanUserResizeColumns="True"
					  RowHeight="52">

				<DataGrid.Columns>
					<DataGridTextColumn Header="NR." Binding="{Binding RowNumber}" Width="70"/>
					<DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="*"/>
					<DataGridTextColumn Header="CODE" Binding="{Binding Code}" Width="*"/>
					<DataGridTemplateColumn Header="ACTIONS" Width="110">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<StackPanel Orientation="Horizontal"
											HorizontalAlignment="Center"
											VerticalAlignment="Center"
											Spacing="6"
											x:CompileBindings="false">
									<Button Classes="iconButton"
											ToolTip.Tip="Edit"
											Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
											CommandParameter="{Binding}">
										<Image Source="{SvgImage /Assets/Images/regular/edit.svg}"
											   Width="16" Height="16"/>
									</Button>

									<Button Classes="iconButton danger"
											ToolTip.Tip="Delete"
											Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
											CommandParameter="{Binding}">
										<Image Source="{SvgImage /Assets/Images/regular/delete.svg}"
											   Width="16" Height="16"/>
									</Button>
								</StackPanel>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>
				</DataGrid.Columns>
			</DataGrid>

			<!-- Pagination -->
			<StackPanel Grid.Row="4"
						HorizontalAlignment="Center"
						Orientation="Horizontal"
						Spacing="14">
				<Button Command="{Binding PreviousPageCommand}" IsEnabled="{Binding HasPreviousPage}">
					<Image Source="{SvgImage /Assets/Images/regular/arrow-left-solid-full.svg}"
						   Width="15" Height="15"/>
				</Button>

				<TextBlock Classes="headerText" VerticalAlignment="Center"><Run Text="{Binding PageNumber}"/><Run Text=" of "/><Run Text="{Binding TotalPages}"/></TextBlock>

				<Button Command="{Binding NextPageCommand}" IsEnabled="{Binding HasNextPage}">
					<Image Source="{SvgImage /Assets/Images/regular/arrow-right-solid-full.svg}"
						   Width="15" Height="15"/>
				</Button>
			</StackPanel>
		</Grid>
	</Border>
</UserControl>