<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ByteBuy.UI.ViewModels"
             xmlns:views="clr-namespace:ByteBuy.UI.Views.Shared"
             mc:Ignorable="d" d:DesignWidth="1600" d:DesignHeight="1000"
             x:Class="ByteBuy.UI.Views.EmployeePageView"
             x:DataType="vm:EmployeePageViewModel">

    <UserControl.Styles>
        <StyleInclude Source="../../Styles/EmployeeStyles.axaml" />
    </UserControl.Styles>

    <Grid>
        <Grid RowDefinitions="auto,*" ColumnDefinitions="380,24,*" Margin="0,10,30,30">

            <!--Page Title-->
            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                       Classes="pageTitle" Text="Employee" Margin="0,0,0,20"/>

            <!-- LEFT: profile + permissions -->
            <Grid Grid.Row="1" Grid.Column="0" RowDefinitions="auto,20,*">

                <!-- Profile card -->
                <Border Classes="sectionBorder" Padding="24">
                    <Grid ColumnDefinitions="auto,*" ColumnSpacing="20">
                        <Border Background="{DynamicResource ButtonGradient}"
                                CornerRadius="16"
                                BorderBrush="{DynamicResource PrimaryAccentBrush}"
                                BorderThickness="1"
                                Width="104" Height="104">
                            <Image Source="{SvgImage /Assets/Images/regular/user-tie-solid-full.svg}"
                                   Height="64" Width="64" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Classes="sectionLabel" Text="{Binding FirstName}"/>
                                <TextBlock Classes="sectionLabel" Text="{Binding LastName}"/>
                            </StackPanel>
                            <TextBlock Classes="textBoxLabel"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding Email}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Permissions card -->
                <Border Grid.Row="2" Classes="sectionBorder" Padding="24">
                    <Grid RowDefinitions="auto,16,*">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Image Classes="sectionMarker" VerticalAlignment="Center"
                                   Source="{SvgImage /Assets/Images/regular/square-solid-full-primary.svg}"/>
                            <TextBlock Classes="sectionLabel" Text="Permissions" VerticalAlignment="Center"/>
                        </StackPanel>

                        <views:PermissionGrantRevokeView
                            Grid.Row="2"
                            DataContext="{Binding PermissionListBox}" />
                    </Grid>
                </Border>
            </Grid>

            <!-- RIGHT: form -->
            
                <Grid Grid.Row="1" Grid.Column="2"
                      RowDefinitions="*,auto"
                      RowSpacing="20">

                    <ScrollViewer Grid.Row="0"
                                  Padding="0,0,12,0"
                                  Background="Transparent"
                                  ScrollViewer.AllowAutoHide="False">

                        <StackPanel Spacing="20">

                            <!-- Personal Information + Password -->
                            <Border Classes="sectionBorder" Padding="28,24">
                                <StackPanel Spacing="28">

                                    <!-- Personal Information -->
                                    <StackPanel Spacing="14">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Image Classes="sectionMarker"
                                                   VerticalAlignment="Center"
                                                   Source="{SvgImage /Assets/Images/regular/square-solid-full-primary.svg}"/>
                                            <TextBlock Text="Personal Information"
                                                       Classes="sectionLabel"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <Grid ColumnDefinitions="*,*"
                                              ColumnSpacing="20"
                                              RowDefinitions="auto,auto"
                                              RowSpacing="14">

                                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6">
                                                <TextBlock Text="First Name" Classes="textBoxLabel"/>
                                                <TextBox Text="{Binding FirstName}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="6">
                                                <TextBlock Text="Last Name" Classes="textBoxLabel"/>
                                                <TextBox Text="{Binding LastName}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="6">
                                                <TextBlock Text="Email" Classes="textBoxLabel"/>
                                                <TextBox Text="{Binding Email}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                                                <TextBlock Text="Role" Classes="textBoxLabel"/>
                                                <ComboBox HorizontalAlignment="Stretch"
                                                          ItemsSource="{Binding Roles}"
                                                          SelectedItem="{Binding SelectedRole, Mode=TwoWay}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Title}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Password -->
                                    <StackPanel Spacing="14">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Image Classes="sectionMarker"
                                                   VerticalAlignment="Center"
                                                   Source="{SvgImage /Assets/Images/regular/square-solid-full-primary.svg}"/>
                                            <TextBlock Text="Password"
                                                       Classes="sectionLabel"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
                                            <StackPanel Grid.Column="0" Spacing="6">
                                                <TextBlock Text="Password" Classes="textBoxLabel"/>
                                                <TextBox Text="{Binding Password}" PasswordChar="*"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>

                                </StackPanel>
                            </Border>

                            <!-- Address -->
                            <Border Classes="sectionBorder" Padding="28,24">
                                <StackPanel Spacing="14">

                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Image Classes="sectionMarker"
                                               VerticalAlignment="Center"
                                               Source="{SvgImage /Assets/Images/regular/square-solid-full-primary.svg}"/>
                                        <TextBlock Text="Address"
                                                   Classes="sectionLabel"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <Grid ColumnDefinitions="*,*"
                                          ColumnSpacing="20"
                                          RowDefinitions="auto,auto,auto,auto"
                                          RowSpacing="14">

                                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6">
                                            <TextBlock Text="City" Classes="textBoxLabel"/>
                                            <TextBox Text="{Binding City}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="6">
                                            <TextBlock Text="Street" Classes="textBoxLabel"/>
                                            <TextBox Text="{Binding Street}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="6">
                                            <TextBlock Text="House Number" Classes="textBoxLabel"/>
                                            <TextBox Text="{Binding HouseNumber}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                                            <TextBlock Text="Flat Number" Classes="textBoxLabel"/>
                                            <TextBox Text="{Binding FlatNumber}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="0" Spacing="6">
                                            <TextBlock Text="Postal Code" Classes="textBoxLabel"/>
                                            <TextBox Text="{Binding PostalCode}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="6">
                                            <TextBlock Text="Postal City" Classes="textBoxLabel"/>
                                            <TextBox Text="{Binding PostalCity}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="3" Grid.Column="0" Spacing="6">
                                            <TextBlock Text="Country" Classes="textBoxLabel"/>
                                            <ComboBox HorizontalAlignment="Stretch"
                                                      ItemsSource="{Binding Countries}"
                                                      SelectedItem="{Binding SelectedCountry, Mode=TwoWay}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Title}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Grid.Row="3" Grid.Column="1" Spacing="6">
                                            <TextBlock Text="Phone Number" Classes="textBoxLabel"/>
                                            <TextBox Text="{Binding PhoneNumber}"/>
                                        </StackPanel>

                                    </Grid>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Action bar (always visible) -->
                    <Border Grid.Row="1"
                            Classes="sectionBorder"
                            Padding="20">

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Spacing="12">

                            <Button Content="Clear"
                                    MinWidth="100"
                                    HorizontalContentAlignment="Center"
                                    Command="{Binding ClearCommand}"/>

                            <Button Content="Save"
                                    Classes="accent"
                                    MinWidth="100"
                                    HorizontalContentAlignment="Center"
                                    Command="{Binding SaveCommand}"/>

                        </StackPanel>
                    </Border>

                </Grid>
        </Grid>
    </Grid>
</UserControl>
