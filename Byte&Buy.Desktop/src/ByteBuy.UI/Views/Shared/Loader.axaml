<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:li="using:LoadingIndicators.Avalonia"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="using:ByteBuy.UI.Views.Shared"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:Class="ByteBuy.UI.Views.Shared.Loader">
	<Border
		Grid.Column="1"
		ZIndex="9"
		Background="#80000000">

		<StackPanel
			HorizontalAlignment="Center"
			VerticalAlignment="Center"
			Spacing="10">

			<li:LoadingIndicator
				Mode="Wave"
				SpeedRatio="1"
				Foreground="{DynamicResource PrimaryAccent}"
				Width="150"/>

			<TextBlock
				Text="{Binding Message, RelativeSource={RelativeSource AncestorType={x:Type views:Loader}}}"
				FontWeight="DemiBold"
				Foreground="White"
				HorizontalAlignment="Center"/>

		</StackPanel>
	</Border>

</UserControl>
