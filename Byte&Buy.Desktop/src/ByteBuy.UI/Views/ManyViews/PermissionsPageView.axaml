
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="using:ByteBuy.UI.Views.Shared"
             xmlns:vm="clr-namespace:ByteBuy.UI.ViewModels.ManyViewModels"
             mc:Ignorable="d"
             d:DesignWidth="1300"
             d:DesignHeight="700"
             x:DataType="vm:PermissionsPageViewModel"
             x:Class="ByteBuy.UI.Views.ManyViews.PermissionsPageView">

    <Grid x:Name="Root"
          RowDefinitions="auto,auto,*"
          RowSpacing="20"
          Margin="0,10,30,30">

        <!-- Page Header -->
        <Grid Grid.Row="0" RowDefinitions="auto, auto" RowSpacing="6" ColumnDefinitions="*,auto">
            <TextBlock Classes="pageTitle"
                       Text="Permissions"/>

            <TextBlock Grid.Row="1"
                       Text="Manage permissions, modify."
                       Classes="sectionHelperText"/>

            <Button Grid.Column="1"
                    Classes="accent"
                    Command="{Binding AddCommand}"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Image Source="{SvgImage /Assets/Images/regular/plus-solid-full.svg}"
                           Width="15"
                           Height="15"/>
                    <TextBlock Text="Add" Foreground="White"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Filters -->
        <Border Grid.Row="1"
                Classes="sectionBorder"
                Padding="24,20">

            <StackPanel Spacing="16">

                <StackPanel Orientation="Horizontal" Spacing="14">
                    <Border Classes="sectionIcon">
                        <Image Width="16"
                               Height="16"
                               Source="{SvgImage /Assets/Images/regular/filter-solid-full.svg}"/>
                    </Border>

                    <TextBlock Text="Filters"
                               Classes="sectionLabel"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <WrapPanel Orientation="Horizontal"
                           ItemSpacing="28"
                           LineSpacing="14">

                    <StackPanel Orientation="Horizontal" Spacing="12">

                        <StackPanel Spacing="6">
                            <TextBlock Text="Name"
                                       Classes="textBoxLabel"/>

                            <TextBox Width="180"
                                     Text="{Binding Name}">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter"
                                                Command="{Binding LoadDataCommand}"/>
                                </TextBox.KeyBindings>
                            </TextBox>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Description"
                                       Classes="textBoxLabel"/>

                            <TextBox Width="220"
                                     Text="{Binding Description}">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter"
                                                Command="{Binding LoadDataCommand}"/>
                                </TextBox.KeyBindings>
                            </TextBox>
                        </StackPanel>

                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Spacing="10"
                                VerticalAlignment="Bottom">

                        <Button Command="{Binding LoadDataCommand}" Classes="filterButton">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Image Source="{SvgImage /Assets/Images/regular/filter-solid-full.svg}"
                                       Width="15"
                                       Height="15"/>
                                <TextBlock Text="Filter" Foreground="White"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ClearFiltersCommand}" Height="35" Classes="filterButton">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Image Source="{SvgImage /Assets/Images/regular/filter-circle-xmark-solid-full.svg}"
                                       Width="15"
                                       Height="15"/>
                                <TextBlock Text="Clear"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Table Card -->
        <Border Grid.Row="2"
                Classes="sectionBorder"
                Padding="24,20">

            <Grid RowDefinitions="auto,*,auto"
                  RowSpacing="14">

                <!-- Header -->
                <Grid Grid.Row="0" ColumnDefinitions="*,auto">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <Border Classes="sectionIcon">
                            <PathIcon Data="{DynamicResource IconBox}"/>
                        </Border>

                        <TextBlock Text="Permission List"
                                   Classes="sectionLabel"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Classes="sectionHelperText"
                               VerticalAlignment="Center">
                        <Run Text="Records fetched: "/>
                        <Run Text="{Binding ItemsCount}" FontWeight="Bold"/>
                    </TextBlock>
                </Grid>

                <!-- Data Grid -->
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Items}"
                          AutoGenerateColumns="False"
                          GridLinesVisibility="Horizontal"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          CanUserSortColumns="True"
                          CanUserResizeColumns="True"
                          CanUserReorderColumns="True"
                          RowHeight="52">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="NR."
                                            Binding="{Binding RowNumber}"
                                            Width="70"/>

                        <DataGridTextColumn Header="NAME"
                                            Binding="{Binding Name}"
                                            Width="*"/>

                        <DataGridTextColumn Header="DESCRIPTION"
                                            Binding="{Binding Description}"
                                            Width="1.5*"/>

                        <DataGridTemplateColumn Header="ACTIONS" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Spacing="5"
                                                x:CompileBindings="false">

                                        <Button Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Image Source="{SvgImage /Assets/Images/regular/edit.svg}"
                                                   Width="16"
                                                   Height="16"/>
                                        </Button>

                                        <Button Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Image Source="{SvgImage /Assets/Images/regular/delete.svg}"
                                                   Width="16"
                                                   Height="16"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Pagination -->
                <StackPanel Grid.Row="2"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="14">

                    <Button Command="{Binding PreviousPageCommand}"
                            IsEnabled="{Binding HasPreviousPage}">
                        <Image Source="{SvgImage /Assets/Images/regular/arrow-left-solid-full.svg}"
                               Width="15"
                               Height="15"/>
                    </Button>

                    <TextBlock Classes="headerText"
                               VerticalAlignment="Center">
                        <Run Text="{Binding PageNumber}"/>
                        <Run Text=" of "/>
                        <Run Text="{Binding TotalPages}"/>
                    </TextBlock>

                    <Button Command="{Binding NextPageCommand}"
                            IsEnabled="{Binding HasNextPage}">
                        <Image Source="{SvgImage /Assets/Images/regular/arrow-right-solid-full.svg}"
                               Width="15"
                               Height="15"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
