<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:views="using:ByteBuy.UI.Views.Shared"
			 xmlns:vm="clr-namespace:ByteBuy.UI.ViewModels"
			 mc:Ignorable="d" d:DesignWidth="1300" d:DesignHeight="700"
			 x:Class="ByteBuy.UI.Views.OrdersPageView"
			 x:DataType="vm:OrdersPageViewModel">

	<Grid x:Name="Root" RowDefinitions="auto,auto,*" RowSpacing="20" Margin="0,10,30,30">

		<!-- Page Title -->
		<Grid Grid.Row="0" ColumnDefinitions="auto" RowDefinitions="auto, auto" RowSpacing="6">
			<TextBlock Grid.Row="0" Classes="pageTitle" Text="Orders"/>
			<TextBlock Grid.Row="1"
					   Text="Manage company orders, send, print documents and more."
					   Classes="sectionHelperText"/>
		</Grid>


		<!-- Filters -->
		<Border Grid.Row="1" Classes="sectionBorder" Padding="24,20">
			<StackPanel Spacing="16">

				<StackPanel Orientation="Horizontal" Spacing="14">
					<Border Classes="sectionIcon">
						<Image Width="16" Height="16"
							   Source="{SvgImage /Assets/Images/regular/filter-solid-full.svg}"/>
					</Border>
					<TextBlock Text="Filters" Classes="sectionLabel" VerticalAlignment="Center"/>
				</StackPanel>

				<WrapPanel Orientation="Horizontal" ItemSpacing="28" LineSpacing="14">

					<!-- Buyer -->
					<StackPanel Orientation="Horizontal" Spacing="12">
						<StackPanel Spacing="6">
							<TextBlock Text="Buyer Name" Classes="textBoxLabel"/>
							<TextBox Width="180" Text="{Binding BuyerFullName}">
								<TextBox.KeyBindings>
									<KeyBinding Gesture="Enter" Command="{Binding LoadDataCommand}"/>
								</TextBox.KeyBindings>
							</TextBox>
						</StackPanel>

						<StackPanel Spacing="6">
							<TextBlock Text="Buyer Email" Classes="textBoxLabel"/>
							<TextBox Width="200" Text="{Binding BuyerEmail}">
								<TextBox.KeyBindings>
									<KeyBinding Gesture="Enter" Command="{Binding LoadDataCommand}"/>
								</TextBox.KeyBindings>
							</TextBox>
						</StackPanel>
					</StackPanel>

					<!-- Purchase date -->
					<StackPanel Orientation="Horizontal" Spacing="12">
						<StackPanel Spacing="6">
							<TextBlock Text="Purchased From" Classes="textBoxLabel"/>
							<CalendarDatePicker Width="170" SelectedDate="{Binding PurchasedFrom}"/>
						</StackPanel>

						<StackPanel Spacing="6">
							<TextBlock Text="Purchased To" Classes="textBoxLabel"/>
							<CalendarDatePicker Width="170" SelectedDate="{Binding PurchasedTo}"/>
						</StackPanel>
					</StackPanel>

					<!-- Total -->
					<StackPanel Orientation="Horizontal" Spacing="12">
						<StackPanel Spacing="6">
							<TextBlock Text="Total From" Classes="textBoxLabel"/>
							<NumericUpDown Width="150" Minimum="0" FormatString="N2" Value="{Binding TotalFrom}"/>
						</StackPanel>

						<StackPanel Spacing="6">
							<TextBlock Text="Total To" Classes="textBoxLabel"/>
							<NumericUpDown Width="150" Minimum="0" FormatString="N2" Value="{Binding TotalTo}"/>
						</StackPanel>
					</StackPanel>

					<!-- Actions -->
					<StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom">
						<Button Classes="filterButton" Command="{Binding LoadDataCommand}">
							<StackPanel Orientation="Horizontal" Spacing="8">
								<Image Source="{SvgImage /Assets/Images/regular/filter-solid-full.svg}"
									   Width="15" Height="15"/>
								<TextBlock Text="Filter" Foreground="White"/>
							</StackPanel>
						</Button>

						<Button Classes="filterButton" Command="{Binding ClearFiltersCommand}">
							<StackPanel Orientation="Horizontal" Spacing="8">
								<Image Source="{SvgImage /Assets/Images/regular/filter-circle-xmark-solid-full.svg}"
									   Width="15" Height="15"/>
								<TextBlock Text="Clear"/>
							</StackPanel>
						</Button>
					</StackPanel>
				</WrapPanel>
			</StackPanel>
		</Border>

		<!-- Table card -->
		<Border Grid.Row="2" Classes="sectionBorder" Padding="24,20">
			<Grid RowDefinitions="auto,*,auto" RowSpacing="14">

				<!-- Card header: title + records count -->
				<Grid Grid.Row="0" ColumnDefinitions="*,auto">
					<StackPanel Orientation="Horizontal" Spacing="14">
						<Border Classes="sectionIcon">
							<PathIcon Data="{DynamicResource IconBox}"/>
						</Border>
						<TextBlock Text="Order List" Classes="sectionLabel" VerticalAlignment="Center"/>
					</StackPanel>

					<TextBlock Grid.Column="1" Classes="sectionHelperText" VerticalAlignment="Center"><Run Text="Records fetched: "/><Run Text="{Binding ItemsCount}" FontWeight="Bold"/></TextBlock>
				</Grid>

				<!-- Data Grid Containing All Items -->
				<DataGrid Grid.Row="1"
						  x:Name="ItemsGrid"
						  ItemsSource="{Binding Items}"
						  SelectedItem="{Binding SelectedItem}"
						  AutoGenerateColumns="False"
						  GridLinesVisibility="Horizontal"
						  IsReadOnly="True"
						  HeadersVisibility="Column"
						  CanUserSortColumns="True"
						  CanUserResizeColumns="True"
						  RowHeight="52">

					<DataGrid.Columns>
						<DataGridTextColumn Header="NR." Binding="{Binding RowNumber}" Width="70"/>
						<DataGridTextColumn Header="BUYER FULL NAME" Binding="{Binding BuyerFullName}" Width="*"/>
						<DataGridTextColumn Header="BUYER EMAIL" Binding="{Binding BuyerEmail}" Width="1.3*"/>

						<!-- Status as a pill -->
						<DataGridTemplateColumn Header="ORDER STATUS" Width="150">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<Border Classes="statusPill"
											Classes.success="{Binding Status, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Delivered}"
											HorizontalAlignment="Left"
											VerticalAlignment="Center"
											Margin="12,0,0,0"
											x:CompileBindings="false">
										<TextBlock Text="{Binding Status}"/>
									</Border>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>

						<DataGridTextColumn Header="LINES" Binding="{Binding LinesCount}" Width="80"/>
						<DataGridTextColumn Header="PURCHASED" Binding="{Binding PurchaseDate}" Width="*"/>

						<!-- Total, right aligned -->
						<DataGridTemplateColumn Header="TOTAL" Width="140">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<TextBlock Text="{Binding TotalCost}"
											   FontWeight="700"
											   HorizontalAlignment="Right"
											   VerticalAlignment="Center"
											   Margin="0,0,16,0"
											   x:CompileBindings="false"/>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>

						<DataGridTemplateColumn Header="ACTIONS" Width="100">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<StackPanel Orientation="Horizontal"
												HorizontalAlignment="Center"
												VerticalAlignment="Center"
												x:CompileBindings="false">
										<Button Command="{Binding DataContext.OpenDetailsPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
												CommandParameter="{Binding}">
											<Image Source="{SvgImage /Assets/Images/regular/magnifying-glass-solid-full.svg}"
												   Width="16" Height="16"/>
										</Button>
									</StackPanel>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
					</DataGrid.Columns>
				</DataGrid>

				<!-- Pagination -->
				<StackPanel Grid.Row="2"
							HorizontalAlignment="Center"
							Orientation="Horizontal"
							Spacing="14">
					<Button Command="{Binding PreviousPageCommand}" IsEnabled="{Binding HasPreviousPage}">
						<Image Source="{SvgImage /Assets/Images/regular/arrow-left-solid-full.svg}"
							   Width="15" Height="15"/>
					</Button>

					<TextBlock Classes="headerText" VerticalAlignment="Center"><Run Text="{Binding PageNumber}"/><Run Text=" of "/><Run Text="{Binding TotalPages}"/></TextBlock>

					<Button Command="{Binding NextPageCommand}" IsEnabled="{Binding HasNextPage}">
						<Image Source="{SvgImage /Assets/Images/regular/arrow-right-solid-full.svg}"
							   Width="15" Height="15"/>
					</Button>
				</StackPanel>
			</Grid>
		</Border>
	</Grid>
</UserControl>