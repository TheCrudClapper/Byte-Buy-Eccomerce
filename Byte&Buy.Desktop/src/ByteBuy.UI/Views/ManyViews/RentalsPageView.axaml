
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="using:ByteBuy.UI.Views.Shared"
             xmlns:vm="clr-namespace:ByteBuy.UI.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="1300"
             d:DesignHeight="700"
             x:Class="ByteBuy.UI.Views.RentalsPageView"
             x:DataType="vm:RentalsPageViewModel">

    <Grid x:Name="Root"
          RowDefinitions="auto,auto,*"
          RowSpacing="20"
          Margin="0,10,30,30">

        <!-- Page Title -->
        <Grid Grid.Row="0" ColumnDefinitions="auto" RowDefinitions="auto, auto" RowSpacing="6">
            <TextBlock Grid.Row="0"
                       Classes="pageTitle"
                       Text="Rentals"/>
            <TextBlock Grid.Row="1"
                       Text="Manage company rentals, send, print documents and more."
                       Classes="sectionHelperText"/>
        </Grid>
        <!-- Filters -->
        <Border Grid.Row="1"
                Classes="sectionBorder"
                Padding="24,20">

            <StackPanel Spacing="16">

                <StackPanel Orientation="Horizontal" Spacing="14">
                    <Border Classes="sectionIcon">
                        <Image Width="16"
                               Height="16"
                               Source="{SvgImage /Assets/Images/regular/filter-solid-full.svg}"/>
                    </Border>

                    <TextBlock Text="Filters"
                               Classes="sectionLabel"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <WrapPanel Orientation="Horizontal"
                           ItemSpacing="28"
                           LineSpacing="14">

                    <!-- Rental Item -->
                    <StackPanel Orientation="Horizontal" Spacing="12">

                        <StackPanel Spacing="6">
                            <TextBlock Text="Item"
                                       Classes="textBoxLabel"/>

                            <TextBox Width="180"
                                     Text="{Binding ItemName}">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter"
                                                Command="{Binding LoadDataCommand}"/>
                                </TextBox.KeyBindings>
                            </TextBox>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Borrower Email"
                                       Classes="textBoxLabel"/>

                            <TextBox Width="200"
                                     Text="{Binding BorrowerEmail}">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter"
                                                Command="{Binding LoadDataCommand}"/>
                                </TextBox.KeyBindings>
                            </TextBox>
                        </StackPanel>

                    </StackPanel>

                    <!-- Rental Days -->
                    <StackPanel Orientation="Horizontal" Spacing="12">

                        <StackPanel Spacing="6">
                            <TextBlock Text="Rental Days From"
                                       Classes="textBoxLabel"/>

                            <NumericUpDown Width="150"
                                           Minimum="0"
                                           Value="{Binding RentalDaysFrom}"/>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Rental Days To"
                                       Classes="textBoxLabel"/>

                            <NumericUpDown Width="150"
                                           Minimum="0"
                                           Value="{Binding RentalDaysTo}"/>
                        </StackPanel>

                    </StackPanel>

                    <!-- Rental Period -->
                    <StackPanel Orientation="Horizontal" Spacing="12">

                        <StackPanel Spacing="6">
                            <TextBlock Text="Rented From"
                                       Classes="textBoxLabel"/>

                            <CalendarDatePicker Width="170"
                                                SelectedDate="{Binding RentalStartPeriod}"/>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Rented To"
                                       Classes="textBoxLabel"/>

                            <CalendarDatePicker Width="170"
                                                SelectedDate="{Binding RentalEndPeriod}"/>
                        </StackPanel>

                    </StackPanel>

                    <!-- Actions -->
                    <StackPanel Orientation="Horizontal"
                                Spacing="10"
                                VerticalAlignment="Bottom">

                        <Button Classes="filterButton"
                                Command="{Binding LoadDataCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Image Source="{SvgImage /Assets/Images/regular/filter-solid-full.svg}"
                                       Width="15"
                                       Height="15"/>

                                <TextBlock Text="Filter"
                                           Foreground="White"/>
                            </StackPanel>
                        </Button>

                        <Button Classes="filterButton" Command="{Binding ClearFiltersCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Image Source="{SvgImage /Assets/Images/regular/filter-circle-xmark-solid-full.svg}"
                                       Width="15"
                                       Height="15"/>

                                <TextBlock Text="Clear"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>

                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Table Card -->
        <Border Grid.Row="2"
                Classes="sectionBorder"
                Padding="24,20">

            <Grid RowDefinitions="auto,*,auto"
                  RowSpacing="14">

                <!-- Card Header -->
                <Grid Grid.Row="0"
                      ColumnDefinitions="*,auto">

                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <Border Classes="sectionIcon">
                            <PathIcon Data="{DynamicResource IconBox}"/>
                        </Border>

                        <TextBlock Text="Rental List"
                                   Classes="sectionLabel"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Classes="sectionHelperText"
                               VerticalAlignment="Center">
                        <Run Text="Records fetched: "/>
                        <Run Text="{Binding ItemsCount}"
                             FontWeight="Bold"/>
                    </TextBlock>

                </Grid>

                <!-- Data Grid -->
                <DataGrid Grid.Row="1"
                          x:Name="ItemsGrid"
                          ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedItem}"
                          AutoGenerateColumns="False"
                          GridLinesVisibility="Horizontal"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          CanUserSortColumns="True"
                          CanUserResizeColumns="True"
                          RowHeight="52">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="NR."
                                            Binding="{Binding RowNumber}"
                                            Width="70"/>

                        <DataGridTextColumn Header="ITEM NAME"
                                            Binding="{Binding ItemName}"
                                            Width="*"/>

                        <DataGridTextColumn Header="BORROWER EMAIL"
                                            Binding="{Binding BorrowerEmail}"
                                            Width="1.3*"/>

                        <!-- Status as a pill -->
                        <DataGridTemplateColumn Header="STATUS">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Classes="statusPill"
											Classes.success="{Binding Status, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Active}"
                                            Classes.error="{Binding Status, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Overdue}"
											HorizontalAlignment="Left"
											VerticalAlignment="Center"
											Margin="12,0,0,0"
											x:CompileBindings="false">
										<TextBlock Text="{Binding Status}"/>
									</Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="DAYS"
                                            Binding="{Binding RentalDays}"
                                            Width="90"/>

                        <DataGridTextColumn Header="RENTAL START"
                                            Binding="{Binding StartingRentalDate}"
                                            Width="*"/>

                        <DataGridTextColumn Header="RENTAL END"
                                            Binding="{Binding EndingRentalDate}"
                                            Width="*"/>

                        <!-- Actions -->
                        <DataGridTemplateColumn Header="ACTIONS"
                                                Width="100">

                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>

                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                x:CompileBindings="false">

                                        <Button Command="{Binding DataContext.OpenDetailsPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">

                                            <Image Source="{SvgImage /Assets/Images/regular/magnifying-glass-solid-full.svg}"
                                                   Width="16"
                                                   Height="16"/>

                                        </Button>

                                    </StackPanel>

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>

                <!-- Pagination -->
                <StackPanel Grid.Row="2"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="14">

                    <Button Command="{Binding PreviousPageCommand}"
                            IsEnabled="{Binding HasPreviousPage}">

                        <Image Source="{SvgImage /Assets/Images/regular/arrow-left-solid-full.svg}"
                               Width="15"
                               Height="15"/>

                    </Button>

                    <TextBlock Classes="headerText"
                               VerticalAlignment="Center">
                        <Run Text="{Binding PageNumber}"/>
                        <Run Text=" of "/>
                        <Run Text="{Binding TotalPages}"/>
                    </TextBlock>

                    <Button Command="{Binding NextPageCommand}"
                            IsEnabled="{Binding HasNextPage}">

                        <Image Source="{SvgImage /Assets/Images/regular/arrow-right-solid-full.svg}"
                               Width="15"
                               Height="15"/>

                    </Button>

                </StackPanel>

            </Grid>
        </Border>

    </Grid>
</UserControl>
