<Styles xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Design.PreviewWith>
		<Border Padding="20">
			<ListBox SelectionMode="Multiple" Width="300">
				<ListBoxItem Content="users:read"/>
				<ListBoxItem Content="users:write" IsSelected="True"/>
				<ListBoxItem Content="orders:read"/>
			</ListBox>
		</Border>
	</Design.PreviewWith>

	<Style Selector="TextBlock.sectionLabel">
		<Setter Property="FontFamily" Value="{DynamicResource RalewayBold}"/>
		<Setter Property="FontSize" Value="20"/>
		<Setter Property="FontWeight" Value="700"/>
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
	</Style>

	<Style Selector="TextBlock.textBoxLabel">
		<Setter Property="FontSize" Value="14"/>
		<Setter Property="FontWeight" Value="600"/>
		<Setter Property="FontFamily" Value="{DynamicResource RalewayMedium}"/>
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
	</Style>

	<Style Selector="ListBox">
		<Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
		<Setter Property="FontFamily" Value="{DynamicResource OpenSansMedium}"/>
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="CornerRadius" Value="10"/>
		<Setter Property="Padding" Value="6"/>
		<Setter Property="FontWeight" Value="600"/>
	</Style>

	<Style Selector="ListBoxItem">
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="CornerRadius" Value="8"/>
		<Setter Property="Padding" Value="8,6"/>
		<Setter Property="Margin" Value="0,1"/>
	</Style>

	<Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
		<Setter Property="Background" Value="{DynamicResource HoverAccentBrush}"/>
	</Style>

	<Style Selector="ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
		<Setter Property="Background" Value="{DynamicResource PrimaryAccentBrush}"/>
	</Style>

	<Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
		<Setter Property="Background" Value="{DynamicResource PrimaryAccentBrush}"/>
	</Style>

	<!--Section card: soft border, shadow, accent border on hover-->
	<Style Selector="Border.sectionBorder">
		<Setter Property="Padding" Value="10"/>
		<Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="BorderBrush" Value="{DynamicResource GrayAccentBrush}"/>
		<Setter Property="CornerRadius" Value="14"/>
		<Setter Property="BoxShadow" Value="0 6 20 0 #33000000"/>
		<Setter Property="Transitions">
			<Transitions>
				<BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
			</Transitions>
		</Setter>
	</Style>
	<Style Selector="Border.sectionBorder:pointerover">
		<Setter Property="BorderBrush" Value="{DynamicResource PrimaryAccentBrush}"/>
	</Style>

	<Style Selector="Image.sectionMarker">
		<Setter Property="Height" Value="15"/>
		<Setter Property="Width" Value="15"/>
		<Setter Property="Margin" Value="0,0,5,0"/>
	</Style>
</Styles>
