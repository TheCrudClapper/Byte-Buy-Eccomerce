<Styles xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:dialogHost="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia">

	<Styles.Resources>
		<!-- Sidebar: purple -> dark navy -->
		<LinearGradientBrush x:Key="SidebarGradientBrush" StartPoint="0%,0%" EndPoint="0%,100%">
			<GradientStop Color="#3A2A8F" Offset="0"/>
			<GradientStop Color="#1B1752" Offset="1"/>
		</LinearGradientBrush>

		<!-- Top bar: dark -> purple glow on the right -->
		<LinearGradientBrush x:Key="TopBarGradientBrush" StartPoint="0%,0%" EndPoint="100%,0%">
			<GradientStop Color="#171640" Offset="0"/>
			<GradientStop Color="#2E2386" Offset="1"/>
		</LinearGradientBrush>

		<!-- Page background: navy with a soft purple glow at the bottom -->
		<RadialGradientBrush x:Key="PageBackgroundBrush"
							 Center="30%,100%" GradientOrigin="30%,100%"
							 RadiusX="70%" RadiusY="70%">
			<GradientStop Color="#2A1F66" Offset="0"/>
			<GradientStop Color="#12132E" Offset="1"/>
		</RadialGradientBrush>

		<!-- Status pill tints -->
		<SolidColorBrush x:Key="SuccessSoftBrush" Color="#2622C55E"/>
		<SolidColorBrush x:Key="ErrorSoftBrush" Color="#26EF4444"/>

		<!-- Icons (Material, 24x24) – usage: <PathIcon Data="{DynamicResource IconBox}"/> -->
		<StreamGeometry x:Key="IconBox">M20 2H4c-1 0-2 .9-2 2v3.01c0 .72.43 1.34 1 1.69V20c0 1.1 1.1 2 2 2h14c.9 0 2-.9 2-2V8.7c.57-.35 1-.97 1-1.69V4c0-1.1-1-2-2-2zm-5 12H9v-2h6v2zm5-7H4V4l16-.02V7z</StreamGeometry>
		<StreamGeometry x:Key="IconDocument">M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z</StreamGeometry>
		<StreamGeometry x:Key="IconPerson">M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z</StreamGeometry>
		<StreamGeometry x:Key="IconTruck">M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zM6 18.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm13.5-9l1.96 2.5H17V9.5h2.5zm-1.5 9c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z</StreamGeometry>
		<StreamGeometry x:Key="IconPin">M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z</StreamGeometry>
		<StreamGeometry x:Key="IconUpload">M9 16h6v-6h4l-7-7-7 7h4zm-4 2h14v2H5z</StreamGeometry>
		<StreamGeometry x:Key="IconBell">M12 22c1.1 0 2-.9 2-2h-4c0 1.1.89 2 2 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z</StreamGeometry>
		<StreamGeometry x:Key="IconChevronDown">M16.59 8.59L12 13.17 7.41 8.59 6 10l6 6 6-6z</StreamGeometry>
		<StreamGeometry x:Key="IconInfo">M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z</StreamGeometry>
		<StreamGeometry x:Key="IconCalendar">M20 3h-1V1h-2v2H7V1H5v2H4c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 18H4V8h16v13z</StreamGeometry>
	</Styles.Resources>

	<!--
	AppStyles.axaml – the sole application styles file.
	Order matters (later entries override earlier ones):
	1. Global defaults
	2. Typography
	3. Buttons
	4. Form fields (TextBox, ComboBox, CheckBox, RadioButton, NumericUpDown)
	5. Cards and borders
	6. Table-based lists
	7. Form (product page)
	8. Dashboard
	9. Navigation (sidebar)
	10. Dialogs and validation
	-->

	<!-- ============================================================ -->
	<!-- 1. GLOBAL DEFAULTS                                           -->
	<!-- ============================================================ -->

	<Style Selector="TextBlock">
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
		<Setter Property="FontWeight" Value="500"/>
	</Style>

	<Style Selector="Button Image">
		<Setter Property="Height" Value="20"/>
		<Setter Property="Width" Value="20"/>
	</Style>


	<!-- ============================================================ -->
	<!-- 2. TYPOGRAPHY                                                -->
	<!-- ============================================================ -->

	<Style Selector="TextBlock.pageTitle">
		<Setter Property="FontSize" Value="32"/>
		<Setter Property="FontWeight" Value="700"/>
		<Setter Property="FontFamily" Value="{DynamicResource RalewayBold}"/>
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
	</Style>

	<Style Selector="TextBlock.standardText">
		<Setter Property="FontSize" Value="15"/>
		<Setter Property="FontFamily" Value="OpenSansMedium"/>
		<Setter Property="FontWeight" Value="500"/>
	</Style>

	<Style Selector="TextBlock.smallText">
		<Setter Property="FontSize" Value="12"/>
		<Setter Property="FontFamily" Value="OpenSansMedium"/>
		<Setter Property="FontWeight" Value="500"/>
	</Style>

	<Style Selector="TextBlock.headerText">
		<Setter Property="FontSize" Value="16"/>
		<Setter Property="FontFamily" Value="OpenSansMedium"/>
		<Setter Property="FontWeight" Value="600"/>
	</Style>

	<Style Selector="TextBlock.status">
		<Setter Property="FontSize" Value="18"/>
		<Setter Property="FontWeight" Value="600"/>
		<Setter Property="FontFamily" Value="OpenSansBold"/>
	</Style>

	<Style Selector="TextBlock.bold">
		<Setter Property="FontWeight" Value="600"/>
	</Style>

	<Style Selector="TextBlock.success">
		<Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
	</Style>

	<Style Selector="TextBlock.error">
		<Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
	</Style>

	<Style Selector="TextBlock.sectionLabel">
		<Setter Property="FontFamily" Value="{DynamicResource RalewayBold}"/>
		<Setter Property="FontSize" Value="20"/>
		<Setter Property="FontWeight" Value="700"/>
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
	</Style>

	<Style Selector="Label.sectionLabel">
		<Setter Property="FontFamily" Value="RalewayBold"/>
		<Setter Property="FontSize" Value="20"/>
		<Setter Property="FontWeight" Value="600"/>
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
	</Style>

	<Style Selector="TextBlock.textBoxLabel">
		<Setter Property="FontSize" Value="14"/>
		<Setter Property="FontWeight" Value="600"/>
		<Setter Property="FontFamily" Value="{DynamicResource RalewayMedium}"/>
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
	</Style>

	<Style Selector="TextBlock.sectionText">
		<Setter Property="FontSize" Value="20"/>
		<Setter Property="FontFamily" Value="{DynamicResource RalewayBold}"/>
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
	</Style>

	<Style Selector="TextBlock.sectionHelperText">
		<Setter Property="FontSize" Value="14"/>
		<Setter Property="FontWeight" Value="Medium"/>
		<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
	</Style>

	<Style Selector="TextBlock.fieldLabel">
		<Setter Property="FontSize" Value="13"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="FontFamily" Value="{DynamicResource RalewayMedium}"/>
		<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
	</Style>

	<Style Selector="TextBlock.dialogTitle">
		<Setter Property="FontFamily" Value="{DynamicResource OpenSansBold}"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
		<Setter Property="Margin" Value="5,0"/>
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
	</Style>


	<!-- ============================================================ -->
	<!-- 3. BUTTONS                                                   -->
	<!-- ============================================================ -->

	<Style Selector="Button">
		<Setter Property="Background" Value="{DynamicResource ButtonGradient}"/>
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
		<Setter Property="CornerRadius" Value="10"/>
		<Setter Property="FontWeight" Value="600"/>
		<Setter Property="VerticalContentAlignment" Value="Center"/>
		<Setter Property="HorizontalContentAlignment" Value="Center"/>
		<Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
		<Setter Property="FontFamily" Value="{DynamicResource RalewayBold}"/>
	</Style>

	<Style Selector="Button:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource HoverAccentBrush}"/>
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource SecondaryAccentBrush}"/>
	</Style>

	<Style Selector="Button.menu">
		<Setter Property="Margin" Value="0,5"/>
		<Setter Property="HorizontalAlignment" Value="Stretch"/>
		<Setter Property="HorizontalContentAlignment" Value="Left"/>
		<Setter Property="Background" Value="{DynamicResource ButtonGradient}"/>
	</Style>

	<!-- Rounded button for deletion in miniatures -->
	<Style Selector="Button.deleteBadge">
		<Setter Property="Width" Value="28"/>
		<Setter Property="Height" Value="28"/>
		<Setter Property="Padding" Value="0"/>
		<Setter Property="CornerRadius" Value="14"/>
		<Setter Property="Background" Value="#99000000"/>
		<Setter Property="HorizontalContentAlignment" Value="Center"/>
		<Setter Property="VerticalContentAlignment" Value="Center"/>
	</Style>
	<Style Selector="Button.deleteBadge:pointerover /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="#CCB3261E"/>
	</Style>

	<!-- Primary action (e.g. Export to PDF) -->
	<Style Selector="Button.accent">
		<Setter Property="Padding" Value="16,11"/>
	</Style>

	<Style Selector="Button.accent /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource ButtonGradient}"/>
		<Setter Property="Foreground" Value="White"/>
		<Setter Property="BorderBrush" Value="Transparent"/>
		<Setter Property="CornerRadius" Value="12"/>
	</Style>

	<Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource ButtonGradient}"/>
		<Setter Property="Opacity" Value="0.9"/>
	</Style>

	<Style Selector="Button.filterButton">
		<Setter Property="Height" Value="35"/>
	</Style>
	<!-- ============================================================ -->
	<!-- 4. INPUTS                                                    -->
	<!-- ============================================================ -->

	<!-- TextBox -->
	<Style Selector="TextBox">
		<Setter Property="Background" Value="White"/>
		<Setter Property="Foreground" Value="{DynamicResource TextLightBrush}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource GrayAccentBrush}"/>
		<Setter Property="FontFamily" Value="{DynamicResource OpenSansMedium}"/>
		<Setter Property="CaretBrush" Value="{DynamicResource PrimaryAccentBrush}"/>
	</Style>

	<Style Selector="TextBox:pointerover, TextBox:focus">
		<Setter Property="Foreground" Value="{DynamicResource TextLightBrush}"/>
	</Style>

	<Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement,
	TextBox:focus /template/ Border#PART_BorderElement">
		<Setter Property="BorderBrush" Value="{DynamicResource PrimaryAccentBrush}"/>
		<Setter Property="Background" Value="White"/>
	</Style>

	<Style Selector="TextBox:disabled">
		<Setter Property="Background" Value="{DynamicResource GrayAccentBrush}"/>
		<Setter Property="Foreground" Value="{DynamicResource TextLightBrush}"/>
	</Style>

	<Style Selector="TextBox:disabled /template/ Border#PART_BorderElement">
		<Setter Property="BorderBrush" Value="{DynamicResource GrayAccentBrush}"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="Background" Value="Gray"/>
	</Style>

	<!-- NumericUpDown -->
	<Style Selector="NumericUpDown /template/ TextBox#PART_TextBox,
	NumericUpDown:pointerover /template/ TextBox#PART_TextBox">
		<Setter Property="CornerRadius" Value="3,0,0,3"/>
	</Style>

	<!-- ComboBox -->
	<Style Selector="ComboBox">
		<Setter Property="HorizontalAlignment" Value="Stretch"/>
		<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
		<Setter Property="Background" Value="{DynamicResource BackgroundLightBrush}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource GrayAccentBrush}"/>
		<Setter Property="FontFamily" Value="{DynamicResource OpenSansMedium}"/>
	</Style>

	<Style Selector="ComboBox.wideCombo">
		<Setter Property="HorizontalAlignment" Value="Stretch"/>
	</Style>

	<Style Selector="ComboBox TextBlock">
		<Setter Property="Foreground" Value="{DynamicResource TextLightBrush}"/>
	</Style>

	<Style Selector="ComboBoxItem">
		<Setter Property="Background" Value="{DynamicResource GrayAccentBrush}"/>
	</Style>

	<Style Selector="ComboBoxItem TextBlock">
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
	</Style>

	<Style Selector="ComboBox:pointerover, ComboBox:focus">
		<Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
		<Setter Property="Background" Value="{DynamicResource BackgroundLightBrush}"/>
	</Style>

	<Style Selector="ComboBox:disabled Border#Background">
		<Setter Property="Background" Value="Gray"/>
		<Setter Property="BorderBrush" Value="{DynamicResource GrayAccentBrush}"/>
	</Style>

	<!-- CheckBox -->
	<Style Selector="CheckBox /template/ Border#NormalRectangle">
		<Setter Property="Background" Value="{DynamicResource BackgroundLightBrush}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
	</Style>

	<Style Selector="CheckBox /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Foreground" Value="{DynamicResource TextLightBrush}"/>
		<Setter Property="FontWeight" Value="600"/>
	</Style>

	<Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
		<Setter Property="Background" Value="{DynamicResource ButtonGradient}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
	</Style>

	<Style Selector="CheckBox:disabled /template/ Border#NormalRectangle">
		<Setter Property="BorderBrush" Value="Gray"/>
		<Setter Property="Background" Value="DarkGray"/>
	</Style>

	<!-- RadioButton -->
	<Style Selector="RadioButton:unchecked /template/ Ellipse#OuterEllipse">
		<Setter Property="Stroke" Value="{DynamicResource PrimaryBrush}"/>
		<Setter Property="Fill" Value="Transparent"/>
		<Setter Property="Opacity" Value="1"/>
	</Style>
	<Style Selector="RadioButton:unchecked /template/ Ellipse#CheckOuterEllipse">
		<Setter Property="Opacity" Value="0"/>
	</Style>
	<Style Selector="RadioButton:unchecked /template/ Ellipse#CheckGlyph">
		<Setter Property="Opacity" Value="0"/>
	</Style>

	<Style Selector="RadioButton:checked /template/ Ellipse#OuterEllipse">
		<Setter Property="Opacity" Value="0"/>
	</Style>
	<Style Selector="RadioButton:checked /template/ Ellipse#CheckOuterEllipse">
		<Setter Property="Opacity" Value="1"/>
		<Setter Property="Stroke" Value="{DynamicResource ButtonGradient}"/>
		<Setter Property="Fill" Value="{DynamicResource ButtonGradient}"/>
	</Style>
	<Style Selector="RadioButton:checked /template/ Ellipse#CheckGlyph">
		<Setter Property="Opacity" Value="1"/>
		<Setter Property="Fill" Value="White"/>
		<Setter Property="Stroke" Value="Transparent"/>
	</Style>


	<!-- ============================================================ -->
	<!-- 5. CARDS & BORDERS                                           -->
	<!-- ============================================================ -->

	<!-- Section and form card -->
	<Style Selector="Border.sectionBorder">
		<Setter Property="Padding" Value="10"/>
		<Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="BorderBrush" Value="{DynamicResource GrayAccentBrush}"/>
		<Setter Property="CornerRadius" Value="22"/>
		<Setter Property="BoxShadow" Value="0 10 30 0 #40000000"/>
		<Setter Property="Transitions">
			<Transitions>
				<BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
			</Transitions>
		</Setter>
	</Style>
	<Style Selector="Border.sectionBorder:pointerover">
		<Setter Property="BorderBrush" Value="{DynamicResource PrimaryAccentBrush}"/>
	</Style>

	<!-- Dashboard Card -->
	<Style Selector="Border.card">
		<Setter Property="Background" Value="{DynamicResource CardBackground}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource GrayAccentBrush}"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="CornerRadius" Value="22"/>
		<Setter Property="Padding" Value="16"/>
		<Setter Property="BoxShadow" Value="0 8 24 0 #33000000"/>
		<Setter Property="ClipToBounds" Value="True"/>
		<Setter Property="Transitions">
			<Transitions>
				<BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
			</Transitions>
		</Setter>
	</Style>
	<Style Selector="Border.card:pointerover">
		<Setter Property="BorderBrush" Value="{DynamicResource PrimaryAccentBrush}"/>
	</Style>

	<Style Selector="Border.lineBorder">
		<Setter Property="Padding" Value="10"/>
		<Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="BorderBrush" Value="{DynamicResource PrimaryAccentBrush}"/>
		<Setter Property="CornerRadius" Value="4"/>
	</Style>

	<Style Selector="Image.sectionMarker">
		<Setter Property="Height" Value="15"/>
		<Setter Property="Width" Value="15"/>
		<Setter Property="Margin" Value="0,0,5,0"/>
	</Style>

	<!-- Section icon tile (header of a card) -->
	<Style Selector="Border.sectionIcon">
		<Setter Property="Width" Value="38"/>
		<Setter Property="Height" Value="38"/>
		<Setter Property="CornerRadius" Value="11"/>
		<Setter Property="Background" Value="{DynamicResource ButtonGradient}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource PrimaryAccentBrush}"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
	</Style>
	<Style Selector="Border.sectionIcon > PathIcon">
		<Setter Property="Width" Value="18"/>
		<Setter Property="Height" Value="18"/>
		<Setter Property="Foreground" Value="White"/>
	</Style>

	<!-- Thin divider line -->
	<Style Selector="Border.divider">
		<Setter Property="Height" Value="1"/>
		<Setter Property="Opacity" Value="0.25"/>
		<Setter Property="Background" Value="{DynamicResource PrimaryAccentBrush}"/>
	</Style>

	<!-- Row inside a card (e.g. order line) -->
	<Style Selector="Border.itemRow">
		<Setter Property="Padding" Value="12"/>
		<Setter Property="CornerRadius" Value="16"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="BorderBrush" Value="{DynamicResource GrayAccentBrush}"/>
		<Setter Property="Background" Value="#14FFFFFF"/>
	</Style>


	<!-- ============================================================ -->
	<!-- 6. LISTS & TABLES                                            -->
	<!-- ============================================================ -->

	<Style Selector="TabControl">
		<Setter Property="CornerRadius" Value="10,10,0,0"/>
	</Style>

	<!-- ListBox -->
	<Style Selector="ListBox">
		<Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
		<Setter Property="FontFamily" Value="{DynamicResource OpenSansMedium}"/>
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="CornerRadius" Value="10"/>
		<Setter Property="Padding" Value="6"/>
		<Setter Property="FontWeight" Value="600"/>
	</Style>

	<Style Selector="ListBoxItem">
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="CornerRadius" Value="8"/>
		<Setter Property="Padding" Value="8,6"/>
		<Setter Property="Margin" Value="0,1"/>
	</Style>

	<Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
		<Setter Property="Background" Value="{DynamicResource HoverAccentBrush}"/>
	</Style>

	<Style Selector="ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter,
	ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
		<Setter Property="Background" Value="{DynamicResource PrimaryAccentBrush}"/>
	</Style>

	<!-- DataGrid -->
	<Style Selector="DataGrid">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="FontSize" Value="14"/>
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
		<Setter Property="RowBackground" Value="Transparent"/>
		<Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource GrayAccentBrush}"/>
		<Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
	</Style>

	<Style Selector="DataGridRow">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
		<Setter Property="FontFamily" Value="{DynamicResource OpenSansMedium}"/>
	</Style>
	<Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
		<Setter Property="Fill" Value="{DynamicResource HoverAccentBrush}"/>
		<Setter Property="Opacity" Value="0.35"/>
	</Style>
	<Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
		<Setter Property="Fill" Value="{DynamicResource PrimaryAccentBrush}"/>
		<Setter Property="Opacity" Value="0.35"/>
	</Style>

	<!-- Ukrycie ramki aktywnej komórki -->
	<Style Selector="DataGridCell /template/ Rectangle#CurrentCellBorder">
		<Setter Property="IsVisible" Value="False"/>
	</Style>

	<Style Selector="DataGridColumnHeader">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
		<Setter Property="FontSize" Value="12"/>
		<Setter Property="FontWeight" Value="Bold"/>
		<Setter Property="FontFamily" Value="{DynamicResource RalewayBold}"/>
		<Setter Property="Padding" Value="12,8"/>
		<Setter Property="AreSeparatorsVisible" Value="False"/>
		<Setter Property="BorderBrush" Value="{DynamicResource GrayAccentBrush}"/>
	</Style>
	<!-- Globalny styl TextBlock nadpisuje odziedziczony kolor, wiec ustawiam go wprost -->
	<Style Selector="DataGridColumnHeader TextBlock">
		<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
		<Setter Property="FontWeight" Value="Bold"/>
	</Style>


	<!-- ============================================================ -->
	<!-- 7. FORMS (product site / image upload)                       -->
	<!-- ============================================================ -->

	<Style Selector="Border.highlightable">
		<Setter Property="Transitions">
			<Transitions>
				<BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2"/>
				<BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
			</Transitions>
		</Setter>
	</Style>
	<Style Selector="Border.highlightable:pointerover">
		<Setter Property="BoxShadow" Value="0 0 14 1 Purple"/>
	</Style>

	<Style Selector="Border.dropZone">
		<Setter Property="Background" Value="{DynamicResource GrayAccentBrush}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource PrimaryAccentBrush}"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="CornerRadius" Value="12"/>
	</Style>

	<Style Selector="Border.imageTile">
		<Setter Property="CornerRadius" Value="14"/>
		<Setter Property="ClipToBounds" Value="True"/>
		<Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
	</Style>


	<!-- ============================================================ -->
	<!-- 8. DASHBOARD                                                 -->
	<!-- ============================================================ -->

	<Style Selector="TextBlock.dashHeading">
		<Setter Property="FontSize" Value="28"/>
		<Setter Property="FontFamily" Value="{DynamicResource RalewayBold}"/>
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
	</Style>

	<Style Selector="TextBlock.cardTitle">
		<Setter Property="FontSize" Value="16"/>
		<Setter Property="FontFamily" Value="{DynamicResource RalewayBold}"/>
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
	</Style>

	<Style Selector="TextBlock.cardStat">
		<Setter Property="FontSize" Value="22"/>
		<Setter Property="FontWeight" Value="700"/>
		<Setter Property="FontFamily" Value="OpenSansBold"/>
	</Style>

	<Style Selector="TextBlock.cardSubText">
		<Setter Property="FontSize" Value="14"/>
		<Setter Property="FontFamily" Value="OpenSansMedium"/>
	</Style>

	<!-- KPI -->
	<Style Selector="TextBlock.kpiValue">
		<Setter Property="FontSize" Value="30"/>
		<Setter Property="FontFamily" Value="{DynamicResource RalewayBold}"/>
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
	</Style>

	<Style Selector="TextBlock.kpiLabel">
		<Setter Property="FontSize" Value="13"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
	</Style>

	<Style Selector="Border.kpiIcon">
		<Setter Property="Width" Value="52"/>
		<Setter Property="Height" Value="52"/>
		<Setter Property="CornerRadius" Value="14"/>
		<Setter Property="Background" Value="{DynamicResource ButtonGradient}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource PrimaryAccentBrush}"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
	</Style>
	<Style Selector="Border.kpiIcon > Image">
		<Setter Property="Width" Value="24"/>
		<Setter Property="Height" Value="24"/>
	</Style>

	<!-- Old type of cards with rounded image -->
	<Style Selector="Image.cardImage">
		<Setter Property="Height" Value="35"/>
		<Setter Property="Width" Value="35"/>
		<Setter Property="Stretch" Value="Uniform"/>
		<Setter Property="HorizontalAlignment" Value="Center"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
	</Style>

	<Style Selector="Border.cardImageBorder">
		<Setter Property="Height" Value="55"/>
		<Setter Property="Width" Value="55"/>
		<Setter Property="BorderBrush" Value="{DynamicResource SecondaryAccentBrush}"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="Background" Value="{DynamicResource PrimaryAccentBrush}"/>
		<Setter Property="CornerRadius" Value="40"/>
		<Setter Property="HorizontalAlignment" Value="Center"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
	</Style>

	<!-- Table -->
	<Style Selector="TextBlock.tableHeader">
		<Setter Property="FontSize" Value="11"/>
		<Setter Property="FontWeight" Value="Bold"/>
		<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
	</Style>

	<Style Selector="TextBlock.tableCell">
		<Setter Property="FontSize" Value="13"/>
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
	</Style>

	<Style Selector="Border.tableRow">
		<Setter Property="CornerRadius" Value="10"/>
		<Setter Property="Padding" Value="10"/>
		<Setter Property="Background" Value="Transparent"/>
	</Style>
	<Style Selector="Border.tableRow:pointerover">
		<Setter Property="Background" Value="{DynamicResource HoverAccentBrush}"/>
	</Style>

	<!-- Status pill (+ .success / .error variants) -->
	<Style Selector="Border.statusPill">
		<Setter Property="CornerRadius" Value="10"/>
		<Setter Property="Padding" Value="12,4"/>
		<Setter Property="Background" Value="{DynamicResource GrayAccentBrush}"/>
		<Setter Property="HorizontalAlignment" Value="Center"/>
	</Style>
	<Style Selector="Border.statusPill > TextBlock">
		<Setter Property="FontSize" Value="14"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
	</Style>

	<Style Selector="Border.statusPill.success">
		<Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}"/>
	</Style>
	<Style Selector="Border.statusPill.success > TextBlock">
		<Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
	</Style>

	<Style Selector="Border.statusPill.error">
		<Setter Property="Background" Value="{DynamicResource ErrorSoftBrush}"/>
	</Style>
	<Style Selector="Border.statusPill.error > TextBlock">
		<Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
	</Style>


	<!-- ============================================================ -->
	<!-- 9. NAVIGATION (sidebar)                                      -->
	<!-- ============================================================ -->

	<Style Selector="Button.sidebarMenuButton">
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
		<Setter Property="FontSize" Value="16"/>
		<Setter Property="FontWeight" Value="500"/>
		<Setter Property="HorizontalAlignment" Value="Stretch"/>
		<Setter Property="Margin" Value="0,3"/>
		<Setter Property="Padding" Value="18,13"/>
		<Setter Property="HorizontalContentAlignment" Value="Left"/>
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="CornerRadius" Value="12"/>
		<Setter Property="Background" Value="Transparent"/>
	</Style>

	<Style Selector="Button.sidebarMenuButton TextBlock">
		<Setter Property="VerticalAlignment" Value="Center"/>
	</Style>

	<Style Selector="Button.menuButton">
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
		<Setter Property="FontWeight" Value="600"/>
		<Setter Property="FontFamily" Value="Raleway"/>
		<Setter Property="HorizontalContentAlignment" Value="Center"/>
		<Setter Property="CornerRadius" Value="12"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="BorderBrush" Value="Transparent"/>
		<Setter Property="Background" Value="Transparent"/>
	</Style>

	<!-- Hover -->
	<Style Selector="Button.sidebarMenuButton:pointerover /template/ ContentPresenter,
	Button.menuButton:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource HoverAccentBrush}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource SecondaryAccentBrush}"/>
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
	</Style>

	<!-- Active: solid purple fill (must come after hover) -->
	<Style Selector="Button.sidebarMenuButton.active /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource ButtonGradient}"/>
		<Setter Property="BorderBrush" Value="Transparent"/>
		<Setter Property="Foreground" Value="White"/>
	</Style>
	<Style Selector="Button.menuButton.active /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource HoverAccentBrush}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource SecondaryAccentBrush}"/>
	</Style>


	<!-- ============================================================ -->
	<!-- 10. DIALOGS & VALIDATION                                     -->
	<!-- ============================================================ -->

	<Style Selector="dialogHost|DialogHost">
		<Setter Property="Padding" Value="0"/>
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="OverlayBackground" Value="#80000000"/>
		<Setter Property="PopupTemplate">
			<ControlTemplate>
				<VisualLayerManager IsPopup="True">
					<ContentPresenter Background="Transparent"
									  Content="{TemplateBinding Content}"
									  ContentTemplate="{TemplateBinding ContentTemplate}"
									  Padding="0"/>
				</VisualLayerManager>
			</ControlTemplate>
		</Setter>
	</Style>

	<!-- Default Avalonia validation error styles:
	https://docs.avaloniaui.net/docs/guides/development-guides/data-validation -->
	<Style Selector="DataValidationErrors">
		<Setter Property="Template">
			<ControlTemplate>
				<DockPanel LastChildFill="True">
					<ContentControl DockPanel.Dock="Right"
									ContentTemplate="{TemplateBinding ErrorTemplate}"
									DataContext="{TemplateBinding Owner}"
									Content="{Binding (DataValidationErrors.Errors)}"
									IsVisible="{Binding (DataValidationErrors.HasErrors)}"/>
					<ContentPresenter Name="PART_ContentPresenter"
									  Background="{TemplateBinding Background}"
									  BorderBrush="{TemplateBinding BorderBrush}"
									  BorderThickness="{TemplateBinding BorderThickness}"
									  CornerRadius="{TemplateBinding CornerRadius}"
									  ContentTemplate="{TemplateBinding ContentTemplate}"
									  Content="{TemplateBinding Content}"
									  Padding="{TemplateBinding Padding}"/>
				</DockPanel>
			</ControlTemplate>
		</Setter>
		<Setter Property="ErrorTemplate">
			<DataTemplate x:DataType="{x:Type x:Object}">
				<Canvas Width="14" Height="14" Margin="4 0 1 0" Background="Transparent">
					<Canvas.Styles>
						<Style Selector="ToolTip">
							<Setter Property="Background" Value="{DynamicResource ErrorBrush}"/>
							<Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}"/>
						</Style>
					</Canvas.Styles>
					<ToolTip.Tip>
						<ItemsControl ItemsSource="{Binding}"/>
					</ToolTip.Tip>
					<Path Data="M14,7 A7,7 0 0,0 0,7 M0,7 A7,7 0 1,0 14,7 M7,3l0,5 M7,9l0,2"
						  Stroke="{DynamicResource ErrorBrush}"
						  StrokeThickness="2"/>
				</Canvas>
			</DataTemplate>
		</Setter>
	</Style>

</Styles>