<Styles xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Design.PreviewWith>
		<Border Padding="20">
			<StackPanel Spacing="10" Width="300">
				<TextBlock Classes="sectionText" Text="Section"/>
				<TextBlock Classes="sectionHelperText" Text="Helper text"/>
				<TextBlock Classes="fieldLabel" Text="Field label"/>
				<Border Classes="highlightable dropZone" Height="100"/>
			</StackPanel>
		</Border>
	</Design.PreviewWith>

	<Style Selector="ComboBox.wideCombo">
		<Setter Property="HorizontalAlignment" Value="Stretch"/>
	</Style>

	<Style Selector="TextBlock.sectionText">
		<Setter Property="FontSize" Value="20"/>
		<Setter Property="FontFamily" Value="{DynamicResource RalewayBold}"/>
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
	</Style>

	<Style Selector="TextBlock.sectionHelperText">
		<Setter Property="FontSize" Value="14"/>
		<Setter Property="FontWeight" Value="Medium"/>
		<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
	</Style>

	<!--Small label above inputs-->
	<Style Selector="TextBlock.fieldLabel">
		<Setter Property="FontSize" Value="13"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="FontFamily" Value="{DynamicResource RalewayMedium}"/>
		<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
	</Style>

	<!--Highlightable border (glow + smooth transition)-->
	<Style Selector="Border.highlightable">
		<Setter Property="Transitions">
			<Transitions>
				<BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2"/>
				<BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
			</Transitions>
		</Setter>
	</Style>
	<Style Selector="Border.highlightable:pointerover">
		<Setter Property="BoxShadow" Value="0 0 14 1 Purple"/>
	</Style>

	<!--Image drop zone-->
	<Style Selector="Border.dropZone">
		<Setter Property="Background" Value="{DynamicResource GrayAccentBrush}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource PrimaryAccentBrush}"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="CornerRadius" Value="12"/>
	</Style>

	<!--Image thumbnail-->
	<Style Selector="Border.imageTile">
		<Setter Property="CornerRadius" Value="10"/>
		<Setter Property="ClipToBounds" Value="True"/>
		<Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
	</Style>

	<!--Round delete badge on thumbnails-->
	<Style Selector="Button.deleteBadge">
		<Setter Property="Width" Value="28"/>
		<Setter Property="Height" Value="28"/>
		<Setter Property="Padding" Value="0"/>
		<Setter Property="CornerRadius" Value="14"/>
		<Setter Property="Background" Value="#99000000"/>
		<Setter Property="HorizontalContentAlignment" Value="Center"/>
		<Setter Property="VerticalContentAlignment" Value="Center"/>
	</Style>
	<Style Selector="Button.deleteBadge:pointerover /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="#CCB3261E"/>
	</Style>
</Styles>
