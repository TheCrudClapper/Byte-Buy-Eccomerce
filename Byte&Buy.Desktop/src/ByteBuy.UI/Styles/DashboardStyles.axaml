<Styles xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Design.PreviewWith>
		<Border Padding="20">
			<!-- Add Controls for Previewer Here -->
		</Border>
	</Design.PreviewWith>

			<!-- Card: soft border + shadow, accent border on hover -->
		<Style Selector="Border.dbCard">
			<Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource GrayAccentBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="16"/>
			<Setter Property="Padding" Value="16"/>
			<Setter Property="BoxShadow" Value="0 8 24 0 #33000000"/>
			<Setter Property="ClipToBounds" Value="True"/>
			<Setter Property="Transitions">
				<Transitions>
					<BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
				</Transitions>
			</Setter>
		</Style>
		<Style Selector="Border.dbCard:pointerover">
			<Setter Property="BorderBrush" Value="{DynamicResource PrimaryAccentBrush}"/>
		</Style>

		<!-- Texts -->
		<Style Selector="TextBlock.dbHeading">
			<Setter Property="FontSize" Value="28"/>
			<Setter Property="FontFamily" Value="{DynamicResource RalewayBold}"/>
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
		</Style>
		<Style Selector="TextBlock.dbSub">
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
		</Style>
		<Style Selector="TextBlock.dbCardTitle">
			<Setter Property="FontSize" Value="16"/>
			<Setter Property="FontFamily" Value="{DynamicResource RalewayBold}"/>
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
		</Style>
		<Style Selector="TextBlock.dbKpiValue">
			<Setter Property="FontSize" Value="30"/>
			<Setter Property="FontFamily" Value="{DynamicResource RalewayBold}"/>
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
		</Style>
		<Style Selector="TextBlock.dbKpiLabel">
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
		</Style>
		<Style Selector="TextBlock.dbTh">
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
		</Style>
		<Style Selector="TextBlock.dbTd">
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>

		<!-- KPI icon tile -->
		<Style Selector="Border.dbIconTile">
			<Setter Property="Width" Value="52"/>
			<Setter Property="Height" Value="52"/>
			<Setter Property="CornerRadius" Value="14"/>
			<Setter Property="Background" Value="{DynamicResource ButtonGradient}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource PrimaryAccentBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
		<Style Selector="Border.dbIconTile > Image">
			<Setter Property="Width" Value="24"/>
			<Setter Property="Height" Value="24"/>
		</Style>

		<!-- Table row -->
		<Style Selector="Border.dbRow">
			<Setter Property="CornerRadius" Value="10"/>
			<Setter Property="Padding" Value="10,10"/>
			<Setter Property="Background" Value="Transparent"/>
		</Style>
		<Style Selector="Border.dbRow:pointerover">
			<Setter Property="Background" Value="{DynamicResource HoverAccentBrush}"/>
		</Style>

		<!-- Status pill -->
		<Style Selector="Border.dbPill">
			<Setter Property="CornerRadius" Value="20"/>
			<Setter Property="Padding" Value="12,3"/>
			<Setter Property="Background" Value="{DynamicResource GrayAccentBrush}"/>
			<Setter Property="HorizontalAlignment" Value="Center"/>
		</Style>
		<Style Selector="Border.dbPill > TextBlock">
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
		</Style>

</Styles>
